# =============================================================================
# Clarizen (Planview AdaptiveWork) Copilot Connector — environment template
# =============================================================================
# HOW TO USE THIS FILE
#   1. Copy it to env/.env.local           (non-secret config, may be per-node)
#   2. Put every SECRET_* value in         env/.env.local.user
#   3. NEVER commit .env.local or .env.local.user — only this .example is tracked.
#
# Load order: env/.env.local → env/.env.local.user → ./.env.local →
# ./.env.local.user. Values already present in the real process environment
# ALWAYS win over these files, so container/Windows-service env blocks can
# override anything here. Within the files, the first file to define a key wins.
#
# CONVENTIONS
#   • "REQUIRED" variables must be set or startup fails with
#     "Invalid configuration: Missing <NAME>".
#   • Optional variables show their built-in default; leave them unset to keep it.
#     Every operational knob in the later sections is OFF BY DEFAULT.
#   • Booleans are truthy for: true / 1 / yes (case-insensitive).
# =============================================================================


# -----------------------------------------------------------------------------
# CORE / IDENTITY
# -----------------------------------------------------------------------------
# CONNECTOR_ID (REQUIRED): unique ID for the Graph external connection.
#   3-32 chars, alphanumeric only, must NOT start with a reserved Microsoft
#   prefix (Microsoft, SharePoint, Teams, Exchange, OneDriveBusiness, LinkedIn,
#   Yammer, Connectors, PowerBI, Office365, Viva). Used as the on-disk state key
#   (data/{CONNECTOR_ID}_identity.db, logs/checkpoint_{CONNECTOR_ID}.json,
#   logs/failed_records_{CONNECTOR_ID}.jsonl).
CONNECTOR_ID=ClarizenAdaptiveWork

# CONNECTOR_NAME (optional, default "Clarizen AdaptiveWork"): admin-UI display name.
CONNECTOR_NAME=Clarizen AdaptiveWork

# CONNECTOR_DESCRIPTION (optional): description shown in Microsoft Search.
CONNECTOR_DESCRIPTION=Planview AdaptiveWork (Clarizen) work items synced to Microsoft 365 Copilot.


# -----------------------------------------------------------------------------
# CLARIZEN (Planview AdaptiveWork)
# -----------------------------------------------------------------------------
# CLARIZEN_BASE_URL (optional, default https://api.clarizen.com/v2.0/services):
#   REST API v2 endpoint. EU orgs: https://api2.clarizen.com/v2.0/services.
# CLARIZEN_BASE_URL=https://api.clarizen.com/v2.0/services

# CLARIZEN_USERNAME (REQUIRED): API user login (session auth).
CLARIZEN_USERNAME=api-user@your-org.com

# --- SECRET: put this line in env/.env.local.user, NEVER here
# SECRET_CLARIZEN_PASSWORD (REQUIRED): API user password.
# SECRET_CLARIZEN_PASSWORD=your-clarizen-password

# CLARIZEN_APP_URL (optional, default https://app.clarizen.com): web app base
#   used for result deep links.
# CLARIZEN_APP_URL=https://app.clarizen.com

# CLARIZEN_API_CALLS_PER_DAY (optional, default 25000): client-side daily API
#   budget (Clarizen orgs have a per-org quota — leave headroom for interactive
#   users). On exhaustion the crawl checkpoints and pauses until the next cycle;
#   the budget window resets at UTC midnight.
# CLARIZEN_API_CALLS_PER_DAY=25000

# CLARIZEN_MAX_CALLS_PER_MINUTE (optional, default 60): burst smoothing rate.
# CLARIZEN_MAX_CALLS_PER_MINUTE=60

# CLARIZEN_PAGE_SIZE (optional, default 500, max 5000): rows per query page.
# CLARIZEN_PAGE_SIZE=500

# CLARIZEN_QUERY_LIMIT (optional, default 0 = unlimited): cap rows per object
#   type. Set a small number for dev/debug only.
# CLARIZEN_QUERY_LIMIT=0

# TDW_EXPORT_PATH (optional, default unset): directory of Clarizen data-warehouse
#   bulk export files ({ObjectName}.csv or {ObjectName}.json). When set, FULL
#   crawls read objects from these files instead of spending API budget;
#   incremental crawls always use the live REST API. Objects without an export
#   file automatically fall back to the API.
#   Every export must carry the entity id column ("id" or "Id"): an export with
#   no recognized id column is rejected with a hard error (each row would
#   collapse to one item id and corrupt deletion sync), and individual rows
#   with an empty id are dropped and logged.
# TDW_EXPORT_PATH=/data/clarizen-tdw-exports


# -----------------------------------------------------------------------------
# AZURE AD / MICROSOFT GRAPH
# -----------------------------------------------------------------------------
# The app registration needs these APPLICATION Graph permissions (admin-consented):
#   ExternalConnection.ReadWrite.OwnedBy, ExternalItem.ReadWrite.OwnedBy,
#   User.Read.All (identity sync: email/UPN → Entra object id).
#
# AAD_APP_TENANT_ID (REQUIRED): Entra tenant ID.
AAD_APP_TENANT_ID=00000000-0000-0000-0000-000000000000

# AAD_APP_CLIENT_ID (REQUIRED): Entra application (client) ID.
AAD_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- SECRET: put this line in env/.env.local.user, NEVER here
# SECRET_AAD_APP_CLIENT_SECRET (REQUIRED unless a certificate is configured
#   below): Entra app client secret VALUE. If USE_KEY_VAULT=true this may
#   instead live in Key Vault (below).
# SECRET_AAD_APP_CLIENT_SECRET=your-entra-app-client-secret

# --- Certificate credential (optional; WINS over the client secret) ---------
# Builds an RS256 client_assertion instead of sending a secret — rotation
# runbook in SECURITY.md. The auth mode is logged; key material never is.
# GRAPH_CLIENT_CERT_PATH (optional): PFX/PKCS#12 or PEM (cert + key) file.
#   Path wins over thumbprint if both are set. ACL the file like a secret.
# GRAPH_CLIENT_CERT_PATH=C:\ClarizenConnector\certs\graph-client.pfx
# --- SECRET: put this line in env/.env.local.user, NEVER here
# GRAPH_CLIENT_CERT_PASSWORD (optional): password for an encrypted PFX/PEM.
# GRAPH_CLIENT_CERT_PASSWORD=your-pfx-password
# GRAPH_CLIENT_CERT_THUMBPRINT (optional, Windows only): load the cert from
#   the Windows store (CurrentUser\My, then LocalMachine\My) — no key file on
#   disk. The service account needs private-key Read on the certificate.
# GRAPH_CLIENT_CERT_THUMBPRINT=AA00BB11CC22DD33EE44FF5566778899AABBCCDD

# --- Sovereign / national clouds (all optional; public-cloud defaults) ------
# GRAPH_BASE_URL (default https://graph.microsoft.com): Graph resource endpoint,
#   e.g. https://graph.microsoft.us (US Gov) or
#   https://microsoftgraph.chinacloudapi.cn (21Vianet).
# GRAPH_SCOPE (default <GRAPH_BASE_URL>/.default): token audience — set only if
#   your cloud's audience differs from the base URL.
# GRAPH_API_VERSION (default v1.0): v1.0 or beta.
# AAD_APP_OAUTH_AUTHORITY_HOST (default https://login.microsoftonline.com):
#   token authority host, e.g. https://login.microsoftonline.us.
# GRAPH_BASE_URL=https://graph.microsoft.com

# GRAPH_MAX_RETRIES (optional, default 4): retries on 429/500/502/503/504.
#   See docs/RETRY.md.
# GRAPH_RETRY_BACKOFF_BASE (optional, default 2): backoff base seconds
#   (base * 2^attempt; EVERY wait — server Retry-After included — is clamped
#   to 60s, and only numeric Retry-After values are trusted).


# -----------------------------------------------------------------------------
# CONNECTION & SCHEMA PROVISIONING
# -----------------------------------------------------------------------------
# CONNECTION_TIMEOUT_SECONDS (optional, default 600): max wait for connection /
#   schema provisioning.
# CONNECTION_RETRY_INTERVAL_SECONDS (optional, default 15): poll interval.


# -----------------------------------------------------------------------------
# BATCHING & PARALLELISM
# -----------------------------------------------------------------------------
# INGEST_CHUNK_SIZE (optional, default 200): records per checkpointed chunk.
# INGEST_GRAPH_BATCH_SIZE (optional, default 20): requests per Graph $batch
#   POST. Hard-capped at 20 by the API. GRAPH_BATCH_SIZE is an accepted alias
#   (explicit INGEST_GRAPH_BATCH_SIZE wins when both are set).
# GRAPH_BATCH_WORKERS (optional, default 8): concurrent Graph $batch workers.
#   Higher = more throughput but more 429s; adaptive concurrency dials it
#   1..max on 429s and ramps back after 3 clean windows. In HA_MODE set this
#   to (single-node value ÷ node count) — the Graph 429 quota is shared per
#   connection. NOTE: GRAPH_CONCURRENT_BATCHES is an alias and WINS if both
#   are set. See docs/RETRY.md and docs/SHARDING.md.
# GRAPH_BATCH_WORKERS=8
# GRAPH_CONCURRENT_BATCHES=8


# -----------------------------------------------------------------------------
# ACL ENGINE
# -----------------------------------------------------------------------------
# Per-object ACL modes live in config/schema.json (aclMode / projectField).
#
# CLARIZEN_GROUP_MAPPING (optional, default unset): JSON map of Clarizen group
#   ids to Entra group object ids. Groups without a mapping are EXPANDED to
#   their member users so access is never silently dropped.
# CLARIZEN_GROUP_MAPPING={"/Group/12": "00000000-0000-0000-0000-00000000abcd"}

# CLARIZEN_ADMIN_GROUP_ID (optional, default unset): Entra group granted on
#   every item (Clarizen super-user equivalent).
# CLARIZEN_ADMIN_GROUP_ID=00000000-0000-0000-0000-0000000000ad

# FALLBACK_ACL_GROUP_ID (optional, default unset): Entra group granted when a
#   record resolves to ZERO principals. Unset → such records are skipped
#   (never ingested world-readable by accident).
# FALLBACK_ACL_GROUP_ID=00000000-0000-0000-0000-0000000000fb


# -----------------------------------------------------------------------------
# FINANCIAL-FIELD CLASSIFICATION
# -----------------------------------------------------------------------------
# Fields listed in config/schema.json → financialFields (budget, cost, rates,
# actuals, revenue) get classification properties (ContainsFinancialData=true,
# DataClassification="financial") and are governed by:
#
# FINANCIAL_DATA_MODE (optional, default FILTER — protective):
#   filter (default) — STRIP financial property values from every item, so no
#            reader sees figures through Copilot regardless of ACL.
#   tag    — ingest values normally, classification properties only. NOTE: tag
#            does NOT restrict the values — any reader with item access still
#            sees the figures. validate-config emits a loud warning in tag mode.
#   acl    — restrict items carrying financial data to FINANCIAL_DATA_GROUP_ID
#            via item-level ACL (grants replaced, denies preserved).
# FINANCIAL_DATA_MODE=filter

# FINANCIAL_DATA_GROUP_ID: REQUIRED when FINANCIAL_DATA_MODE=acl. Entra group
#   object id allowed to see financially classified items.
# FINANCIAL_DATA_GROUP_ID=00000000-0000-0000-0000-0000000000f1


# -----------------------------------------------------------------------------
# UNIFIED CLASSIFICATION (docs/CLASSIFICATION.md)
# -----------------------------------------------------------------------------
# CLASSIFICATION (optional, default off): derive a SensitivityLabel
#   (Public|Internal|Confidential|Restricted) + DetectedCategories per item from
#   detected PII/PCI/secrets, the financial signal, and the per-object default.
#   IMPORTANT: SensitivityLabel is an ADVISORY connector-applied classification
#   TAG. It is NOT a Microsoft Purview / MIP sensitivity label and is NOT
#   enforced by Purview/DLP/encryption — by itself it only informs search and
#   downstream tooling. Use CLASSIFICATION_ENFORCE_ACL to make the top tier
#   actually restrictive.
# CLASSIFICATION=true
# CLASSIFICATION_MANIFEST (optional, default off): also write a per-crawl JSONL
#   (logs/classification_*.jsonl) for catalog/DLP ingestion. No Purview API call.
# CLASSIFICATION_MANIFEST=true
#
# CLASSIFICATION_ENFORCE_ACL (optional, default off): OPTIONAL ENFORCEMENT — when
#   true, top-tier (Restricted) items get their ACL grants replaced with a single
#   grant to CLASSIFICATION_RESTRICTED_GROUP_ID (denies preserved), turning the
#   advisory tag into a real connector-layer ACL restriction. Requires
#   CLASSIFICATION=true and the group below; the decision is written to the audit
#   ledger. Off = the tag stays advisory (non-breaking).
# CLASSIFICATION_ENFORCE_ACL=true
# CLASSIFICATION_RESTRICTED_GROUP_ID: REQUIRED when CLASSIFICATION_ENFORCE_ACL=true.
#   Entra group object id that Restricted items are locked to.
# CLASSIFICATION_RESTRICTED_GROUP_ID=00000000-0000-0000-0000-0000000000c1


# =============================================================================
# OPERATIONAL KNOBS — all OFF BY DEFAULT (unset == classic file/SQLite behaviour)
# =============================================================================

# -----------------------------------------------------------------------------
# SQL SERVER STATE BACKEND — docs/SQL_CONTRACT.md
# -----------------------------------------------------------------------------
# Moves identity store, checkpoints, sync timestamps and the dead-letter queue
# into a shared SQL Server database. Required for HA. Provision once with
# scripts/sql/create-database.sql.
#
# USE_SQL_SERVER=false
# SQL_CONNECTION_STRING=Server=tcp:clz-ag-listener,1433;Database=ClarizenConnector;User ID=clz_app;Password=<in .env.local.user>;Encrypt=True
# SQL_USE_MANAGED_IDENTITY=false     # Entra Managed Identity token instead of SQL creds
# SQL_MAX_RETRIES=5                  # transient-fault retry (AG failover)

# -----------------------------------------------------------------------------
# HIGH AVAILABILITY (active-active) — docs/HA.md
# -----------------------------------------------------------------------------
# Requires USE_SQL_SERVER=true (startup fails fast otherwise). Every node runs
# the SAME --continuous command against the SAME database.
#
# HA_MODE=false
# NODE_ID=clz-node-1                 # default: machine name; set explicitly in containers
# HA_CLAIM_TIMEOUT_SECONDS=300       # stale-heartbeat takeover threshold
# HA_HEARTBEAT_SECONDS=60            # heartbeat interval while working a claim

# -----------------------------------------------------------------------------
# RETRY / THROTTLING — docs/RETRY.md
# -----------------------------------------------------------------------------
# GRAPH_RETRY_JITTER=false           # true → ±20% jitter on COMPUTED backoff
#                                    # (server Retry-After never jittered).
#                                    # Strongly recommended on every HA node.

# -----------------------------------------------------------------------------
# LOG RETENTION
# -----------------------------------------------------------------------------
# LOG_RETENTION_DAYS=0               # >0 prunes logs/{prefix}_{timestamp}/ run
#                                    # dirs older than N days at the start of
#                                    # every command and each continuous cycle.
#                                    # Root state files are never touched.

# -----------------------------------------------------------------------------
# AZURE KEY VAULT (secret resolution)
# -----------------------------------------------------------------------------
# When enabled, SECRET_* values are read from Key Vault. Vault secret name =
# env-var name lowercased with '_'→'-' (SECRET_CLARIZEN_PASSWORD →
# secret-clarizen-password). Auth: DefaultAzureCredential. Fetch failures fall
# back to the env var when present.
#
# USE_KEY_VAULT=false
# KEY_VAULT_URI=https://your-vault.vault.azure.net/

# -----------------------------------------------------------------------------
# OBSERVABILITY — docs/OBSERVABILITY.md
# -----------------------------------------------------------------------------
# HEALTH_PORT=8080                   # >0 → serve /health, /ready, /metrics
# LOG_FORMAT=text                    # json → one JSON object per log line
# LOG_LEVEL=DEBUG                    # raise the floor for every sink
#                                    # (DEBUG|INFO|WARNING|ERROR; default DEBUG).
#                                    # The ingest hot path gates per-item debug
#                                    # strings on this (isEnabledFor semantics).
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/xxxx
# ALERT_DEADLETTER_THRESHOLD=0       # >0 → alert when dead-letter depth exceeds it

# -----------------------------------------------------------------------------
# ATTACHMENT CONTENT INGESTION — docs/ATTACHMENTS.md
# -----------------------------------------------------------------------------
# When ON, attachment binaries (object types with an attachmentUrlField in
# config/schema.json) are downloaded and their text extracted (dependency-free:
# docx/xlsx/pptx/pdf/text/csv/html) and appended to the attachment item's
# content. The item still inherits its parent's ACLs, is inventoried, and is
# swept on deletion — content ingestion is purely additive. Off = metadata only.
#
# ATTACHMENT_INGESTION (optional, default false): master switch.
# ATTACHMENT_INGESTION=false

# ATTACHMENT_MAX_BYTES (optional, default 10485760 = 10 MiB): per-file size cap,
#   enforced against the declared FileSize and again as a hard streamed cap.
# ATTACHMENT_MAX_BYTES=10485760

# ATTACHMENT_ALLOWED_TYPES (optional, default: txt,csv,tsv,log,md,json,xml,htm,
#   html,docx,xlsx,pptx,pdf): comma/space list of extensions or mime types.
#   Files outside the list are skipped (metadata only) without downloading.
# ATTACHMENT_ALLOWED_TYPES=pdf,docx,xlsx,pptx,txt,csv,html

# -----------------------------------------------------------------------------
# DELETION / TOMBSTONE SYNC — docs/DELETION_SYNC.md
# -----------------------------------------------------------------------------
# Clarizen has no deletion feed, so full crawls run an existence sweep: every
# successfully ingested item id is tracked in the item inventory
# (data/{CONNECTOR_ID}_inventory.db, or dbo.ItemInventory on SQL Server), and
# inventory ids missing from the full-crawl source are DELETEd from the Graph
# connection. Incremental crawls never sweep. `reconcile [--fix]` reports (and
# repairs) index-vs-source drift on demand.
#
# DELETION_SYNC (optional, default true): false → never delete; the inventory
#   is still maintained so reconcile keeps working.
# DELETION_SYNC=true

# DELETION_SYNC_MAX_PERCENT (optional, default 25): mass-deletion safety guard.
#   When more than this percentage of an object type's inventory would be
#   deleted in one sweep the sweep is SKIPPED with a warning +
#   `deletion_sweep_skipped` alert — protection against a source outage or
#   truncated TDW export nuking the index. The guard engages once the inventory
#   holds >= 20 items, OR (at any size) whenever the full crawl's source
#   returned ZERO rows for the object type — so a tiny all-stale inventory can
#   no longer be wiped 100% unguarded. 0 or 100 disables the percent guard
#   explicitly; values outside [0, 100] are a misconfiguration and fall back to
#   the default 25 with a warning (a negative value never silently disables the
#   guard). `reconcile --fix` bypasses it (explicit operator intent).
# DELETION_SYNC_MAX_PERCENT=25

# DELETION_SYNC_MAX_ITEMS (optional, default 1000): absolute mass-deletion cap.
#   Never auto-delete more than this many items of one object type in a single
#   sweep, regardless of inventory size — this also guards small object types
#   the percent guard's >= 20-item floor does not cover. 0 disables the cap
#   explicitly; a negative value falls back to the default with a warning.
# DELETION_SYNC_MAX_ITEMS=1000

# -----------------------------------------------------------------------------
# CONNECTION SHARDING — docs/SHARDING.md
# -----------------------------------------------------------------------------
# GRAPH_CONNECTION_SHARDS (optional, default unset): JSON mapping each Graph
#   connection id to the object types it owns. When set, each shard is its own
#   Graph connection + schema and ingests only its object types (the rate
#   limit is per connection, so k shards ≈ k × single-connection throughput).
#   Every schema.json object must be assigned to exactly one shard (no dups,
#   no unknowns) — validate-config checks this in preflight.
# GRAPH_CONNECTION_SHARDS={"clarizenWorkA":["Project","Task","Milestone"],"clarizenWorkB":["Issue","Risk","Timesheet","RegularResourceLink","Discussion","Attachment"]}

# -----------------------------------------------------------------------------
# INCREMENTAL IDENTITY SYNC
# -----------------------------------------------------------------------------
# IDENTITY_SYNC_ON_INCREMENTAL (optional, default TRUE): re-sync Clarizen→Entra
#   entitlements on incremental crawls too, so entitlement changes propagate at
#   the incremental cadence instead of only on full crawls. Set to false to skip
#   it on incrementals (full crawls always sync). A residual, NON-real-time lag
#   remains between an entitlement change and the next incremental crawl — for
#   tighter bounds schedule a re-ACL sweep on a cadence (docs/DEPLOYMENT_ENTERPRISE.md).
# IDENTITY_SYNC_ON_INCREMENTAL=true

# -----------------------------------------------------------------------------
# EVENT-DRIVEN INCREMENTAL (webhooks) — docs/WEBHOOKS.md
# -----------------------------------------------------------------------------
# When ON (in --continuous mode) an HTTP receiver turns Clarizen change
# notifications into targeted incremental work — upserts re-ingest by id,
# deletes withdraw the item (reusing the deletion/inventory machinery). The
# polling cursor stays the default and the fallback whenever the receiver is
# off or down. Off by default = behaviour unchanged.
#
# CLARIZEN_WEBHOOK_PORT (optional, default off): >0 enables the receiver.
# CLARIZEN_WEBHOOK_PORT=8443

# CLARIZEN_WEBHOOK_SECRET: REQUIRED when the port is set. HMAC-SHA256 shared
#   secret; the receiver validates every post before parsing/enqueuing and
#   FAILS CLOSED (won't start) if this is missing. Put it in .env.local.user.
# CLARIZEN_WEBHOOK_SECRET=your-strong-shared-secret

# CLARIZEN_WEBHOOK_PATH (optional, default /webhook): POST path accepted.
# CLARIZEN_WEBHOOK_SIGNATURE_HEADER (optional, default X-Clarizen-Signature).
# CLARIZEN_WEBHOOK_DEBOUNCE_MS (optional, default 2000): per-entity coalesce
#   window; bursts for one record collapse to a single ingest (last writer wins).
# CLARIZEN_WEBHOOK_DEBOUNCE_MS=2000
#
# Anti-replay (bind a signed timestamp into the HMAC):
#   The sender sends a timestamp header and signs "{timestamp}.{body}", so a
#   stale or forged timestamp is detectable. A duplicate signature within the
#   window is rejected. Validation still happens BEFORE any JSON parse.
# CLARIZEN_WEBHOOK_TIMESTAMP_HEADER (optional, default X-Clarizen-Timestamp):
#   header carrying the Unix-seconds (or ISO-8601) signed timestamp.
# CLARIZEN_WEBHOOK_REQUIRE_TIMESTAMP (optional, default TRUE): strict anti-replay.
#   A post without a timestamp is rejected. Set to false ONLY to migrate senders
#   that cannot yet send a timestamp — those fall back to legacy body-only HMAC
#   with NO replay protection.
# CLARIZEN_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS (optional, default 300): freshness
#   window; a request older/newer than this is rejected fail-closed.
# CLARIZEN_WEBHOOK_MAX_PENDING (optional, default 100000): cap on DISTINCT
#   pending entities in the debouncer. A flood of distinct signed events evicts
#   the oldest pending entity (drop-oldest back-pressure) so memory is bounded;
#   the polling cursor reconciles anything dropped.
# CLARIZEN_WEBHOOK_REQUIRE_TIMESTAMP=true

# -----------------------------------------------------------------------------
# DISTRIBUTED TRACING (OpenTelemetry) — docs/TRACING.md
# -----------------------------------------------------------------------------
# When OTEL_EXPORTER_OTLP_ENDPOINT is set, the connector exports spans around
# the crawl cycle, per-object crawl, source fetch, transform, Graph ingest,
# deletion sweep and webhook events, and stamps a correlation id on every log
# line + dead-letter record + span so one run is followable end-to-end. Unset =
# no exporter, no listener, a genuine no-op (default overhead unchanged). Export
# is batched/fire-and-forget — an unreachable collector never stalls a crawl.
# Standard OTEL env vars are honoured:
#
# OTEL_EXPORTER_OTLP_ENDPOINT (optional, default off): collector endpoint;
#   setting it enables tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# OTEL_EXPORTER_OTLP_PROTOCOL (optional, default grpc): grpc | http/protobuf.
# OTEL_EXPORTER_OTLP_HEADERS (optional): extra export headers, e.g. auth=Bearer...
# OTEL_SERVICE_NAME (optional, default = CONNECTOR_NAME): service.name resource.
# OTEL_SERVICE_NAME=clarizen-copilot-connector

# -----------------------------------------------------------------------------
# CIRCUIT BREAKERS & DEGRADED MODE — docs/RESILIENCE.md
# -----------------------------------------------------------------------------
# A breaker per external dependency (clarizen, graph) fails fast during a
# SUSTAINED outage and pauses the crawl at a safe checkpoint boundary (no state
# loss), auto-recovering when half-open probes succeed. Only real failures
# (5xx/timeout/connection) count — 4xx and honoured 429 do not. On by default
# but inert on the happy path.
#
# CIRCUIT_BREAKER (optional, default true): false = pure passthrough (breakers
#   never engage; guaranteed-unchanged escape hatch).
# CIRCUIT_BREAKER=true

# CIRCUIT_BREAKER_FAILURE_THRESHOLD (optional, default 5): real failures within
#   the window before tripping to open.
# CIRCUIT_BREAKER_WINDOW_SECONDS (optional, default 60): rolling sample window.
# CIRCUIT_BREAKER_OPEN_SECONDS (optional, default 30): open duration before a
#   half-open probe is admitted (also the bounded degraded-retry backoff).
# CIRCUIT_BREAKER_HALF_OPEN_TRIALS (optional, default 2): probe successes needed
#   to close (and concurrent probes admitted in half-open).
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_OPEN_SECONDS=30


# -----------------------------------------------------------------------------
# ENTERPRISE HARDENING — docs/DEPLOYMENT_ENTERPRISE.md
# -----------------------------------------------------------------------------
# --- Windows Event Log sink (docs/SIEM.md) ----------------------------------
# EVENTLOG_ENABLED (optional, default false): mirror Logger.Error/Warning and
#   service start/stop lifecycle to the Windows Application log, source
#   "ClarizenConnector" (stable event ids 1000/1001/1002/2000/3000). No-op off
#   Windows; the sink never throws. install-windows-service.ps1 (or the MSI)
#   creates the source idempotently.
# EVENTLOG_ENABLED=true
# EVENTLOG_LEVEL (optional, default unset): "info" additionally mirrors
#   Logger.Info (event id 1000). Debug is never mirrored.
# EVENTLOG_LEVEL=info

# --- Outbound proxy + custom trust roots ------------------------------------
# Apply to EVERY outbound HTTP client (Clarizen, Graph, alert webhooks); the
# two inbound listeners are unaffected. All three fail fast at startup, naming
# the setting, on an invalid value.
# PROXY_URL (optional): http(s)://[user:pass@]host:port corporate egress proxy.
# PROXY_URL=http://proxy.corp.local:8080
# PROXY_BYPASS (optional): comma/semicolon/space host list that goes DIRECT —
#   exact host, "*.suffix", ".suffix", or bare domain (also matches subdomains).
# PROXY_BYPASS=*.corp.local, localhost
# CA_BUNDLE_PATH (optional): PEM bundle of ADDITIONAL trusted roots for
#   TLS-inspecting proxies / private CAs. Additive — platform trust keeps
#   working, hostname mismatches are never overridden. ACL like a secret.
# CA_BUNDLE_PATH=C:\ClarizenConnector\certs\corp-roots.pem

# --- Dead-letter payload protection (docs/THREAT_MODEL.md) ------------------
# DEADLETTER_PAYLOAD_MODE (optional, default REDACTED — protective): full | redacted.
#   redacted (default) strips property/content values, ACL entries and response
#   bodies from dead-letter records (ids, object type, error and per-field
#   SHA-256 hashes are kept) — including the financial-classification paths.
#   retry-failed re-fetches from source, so redaction costs nothing. Set to
#   `full` only for diagnostic-rich records where the queue is ACL'd tightly.
#   Any other value fails fast at config load.
# DEADLETTER_PAYLOAD_MODE=redacted

# --- Immutable decision audit ledger (docs/THREAT_MODEL.md) -----------------
# DECISION_LEDGER (optional, default TRUE): append-only, SHA-256 hash-chained
#   audit of governance DECISIONS — item EXCLUSIONS (skipped, no resolvable ACL)
#   and ACL RESTRICTIONS (FINANCIAL_DATA_MODE=acl, CLASSIFICATION_ENFORCE_ACL).
#   Low-volume (never every ingest). Written to logs/decisions_<connectorId>.jsonl;
#   tamper/reorder/removal breaks the chain (self-verifiable). false disables it.
# DECISION_LEDGER=true

# --- Stale-index expiry (docs/DELETION_SYNC.md) -----------------------------
# GRAPH_ITEM_TTL_DAYS (optional, default unset = no expiry): when > 0, ingested
#   items are stamped with expirationDateTime = now + TTL so the Graph index
#   self-expires if crawling stops after an outage (defense-in-depth). Set it
#   comfortably above your full-crawl cadence so healthy items never expire.
# GRAPH_ITEM_TTL_DAYS=30
