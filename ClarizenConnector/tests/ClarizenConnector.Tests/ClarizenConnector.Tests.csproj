<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.4.83" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.78.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Chassis migration aliases (mirror src): migrated types resolve to the
         chassis by simple name so test call sites are untouched. -->
    <Using Include="Connector.Chassis.EnvFlags" Alias="EnvFlags" />
    <Using Include="Connector.Chassis.EventLogEntryKind" Alias="EventLogEntryKind" />
    <Using Include="Connector.Chassis.ServiceHost" Alias="ServiceHost" />
    <Using Include="Connector.Chassis.ServiceStop" Alias="ServiceStop" />
    <Using Include="Connector.Chassis.Alerting" Alias="Alerting" />
    <Using Include="Connector.Chassis.LogRedaction" Alias="LogRedaction" />
    <!-- R3: SecretProvider consumed from chassis. -->
    <Using Include="Connector.Chassis.SecretProvider" Alias="SecretProvider" />
    <!-- R5: SQL access seam. ISqlGateway + the gateway impl (chassis SqlGateway)
         consumed by simple names; SqlExecutor aliases to the chassis SqlGateway
         so `new SqlExecutor()` / SqlExecutor.EnsureEncrypt resolve unchanged. -->
    <Using Include="Connector.Chassis.ISqlGateway" Alias="ISqlGateway" />
    <Using Include="Connector.Chassis.SqlGateway" Alias="SqlExecutor" />
    <!-- R2: Logging unified into the chassis. -->
    <Using Include="Connector.Chassis.Logging" Alias="Logging" />
    <Using Include="Connector.Chassis.IAppLogger" Alias="IAppLogger" />
    <Using Include="Connector.Chassis.LogLevel" Alias="LogLevel" />
    <!-- R4 (re-platform): Metrics is a connector-side facade
         (ClarizenConnector.Infrastructure.Metrics); tests resolve it by simple
         name via the Infrastructure usings already present in the test files. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClarizenConnector\ClarizenConnector.csproj" />
  </ItemGroup>

  <!-- Real config assets used by fixture-based tests; several test classes swap
       process-global seams (SyncState.LogsDir, env vars, Logging), so test
       collections must not run in parallel. -->
  <ItemGroup>
    <Content Include="..\..\config\**" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
