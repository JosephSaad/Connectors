# =============================================================================
# BDH (Hadoop data mart) Copilot Connector — environment template
# =============================================================================
# HOW TO USE THIS FILE
#   1. Copy it to env/.env.local           (non-secret config, may be per-node)
#   2. Put every SECRET_* value in         env/.env.local.user
#   3. NEVER commit .env.local or .env.local.user — only this .example is tracked.
#
# Load order: env/.env.local → env/.env.local.user → ./.env.local →
# ./.env.local.user. Values already present in the real process environment
# ALWAYS win over these files, so container/Windows-service env blocks can
# override anything here. Within the files, the first file to define a key wins.
#
# CONVENTIONS
#   • "REQUIRED" variables must be set or startup fails with
#     "Invalid configuration: Missing <NAME>".
#   • Optional variables show their built-in default; leave them unset to keep it.
#     Every operational knob in the later sections is OFF BY DEFAULT.
#   • Booleans are truthy for: true / 1 / yes (case-insensitive).
# =============================================================================


# -----------------------------------------------------------------------------
# CORE / IDENTITY
# -----------------------------------------------------------------------------
# CONNECTOR_ID (REQUIRED): unique ID for the Graph external connection.
#   3-32 chars, alphanumeric only, must NOT start with a reserved Microsoft
#   prefix (Microsoft, SharePoint, Teams, Exchange, OneDriveBusiness, LinkedIn,
#   Yammer, Connectors, PowerBI, Office365, Viva). Used as the on-disk state key
#   (data/{CONNECTOR_ID}_identity.db, logs/checkpoint_{CONNECTOR_ID}.json,
#   logs/failed_records_{CONNECTOR_ID}.jsonl).
#   WARNING: use a DIFFERENT connection id from the live Salesforce connector —
#   both emit the same Salesforce record ids, and pointing them at one
#   connection makes their crawls and deletion sweeps fight each other.
CONNECTOR_ID=BdhHadoopMart

# CONNECTOR_NAME (optional, default "BDH Hadoop Data Mart"): admin-UI display name.
CONNECTOR_NAME=BDH Hadoop Data Mart

# CONNECTOR_DESCRIPTION (optional): description shown in Microsoft Search.
CONNECTOR_DESCRIPTION=Salesforce data from the BDH Hadoop data mart (nightly sync) indexed for Microsoft 365 Copilot.


# -----------------------------------------------------------------------------
# BDH SOURCE ACCESS (HDFS)
# -----------------------------------------------------------------------------
# HDFS_MODE (optional, default webhdfs): webhdfs | localpath.
#   webhdfs   — WebHDFS REST against the namenode (LISTSTATUS + OPEN).
#   localpath — read the same layout from a local/SMB-mounted directory
#               (dev / DR / air-gapped replicas).
HDFS_MODE=webhdfs

# HDFS_NAMENODE_URL (REQUIRED when HDFS_MODE=webhdfs): WebHDFS endpoint
#   including the /webhdfs/v1 prefix. For a kerberized cluster point this at
#   an Apache Knox gateway URL instead — Kerberos/SPNEGO from the connector
#   itself is out of scope.
HDFS_NAMENODE_URL=http://namenode:9870/webhdfs/v1

# HDFS_USER (optional, default unset): simple-auth user sent as ?user.name=.
# HDFS_USER=svc-bdh-reader

# --- SECRET: put this line in env/.env.local.user, NEVER here
# SECRET_HDFS_DELEGATION_TOKEN (optional): HDFS delegation token appended as
#   ?delegation= on every call (obtain it out-of-band; renewal is external).
# SECRET_HDFS_DELEGATION_TOKEN=your-delegation-token

# BDH_ROOT_PATH (optional, default /data/bdh): HDFS path of the data-mart root.
#   Layout underneath: {root}/{object}/dt=YYYY-MM-DD/... (extra Hive partition
#   keys like region=EMEA are allowed at any level).
# BDH_ROOT_PATH=/data/bdh

# BDH_EXPORT_PATH (REQUIRED when HDFS_MODE=localpath): local directory with the
#   same {object}/dt=.../ layout.
# BDH_EXPORT_PATH=/mnt/bdh-export


# -----------------------------------------------------------------------------
# SCALE & FRESHNESS — the reason this connector exists (docs/FILTERS.md)
# -----------------------------------------------------------------------------
# Filters live in config/filters.json (partition pruning + record predicates
# per object). An object with NO filter refuses to crawl unless it is listed
# in filters.json fullScanAllowed or ALLOW_FULL_SCAN=true — at 150M+ rows an
# accidental unfiltered scan is an outage. validate-config --strict errors on
# unfiltered objects.
#
# BDH_FILTERS_PATH (optional, default config/filters.json): filter config path.
# BDH_FILTERS_PATH=config/filters.json

# ALLOW_FULL_SCAN (optional, default false): true disables the fail-closed
#   full-scan guard globally. Prefer per-object fullScanAllowed entries.
# ALLOW_FULL_SCAN=false

# BDH_LAG_HOURS (optional, default 24): BDH is loaded nightly and can lag the
#   live org by up to a day. Incremental crawls read dt partitions newer than
#   (last sync − this many hours) so late-arriving loads are re-read; every
#   item carries DataAsOf so Copilot answers can surface staleness.
# BDH_LAG_HOURS=24

# BDH_MAX_RECORDS_PER_OBJECT (optional, default 500000; 0 disables): row-cap
#   safety valve per object per crawl. Hitting it logs a warning, raises a
#   `row_cap_hit` alert and marks the crawl PARTIAL for that object (its
#   deletion sweep is skipped) — never a silent truncation.
# BDH_MAX_RECORDS_PER_OBJECT=500000

# BDH_MAX_FILE_BYTES (optional, default 1073741824 = 1 GiB): per-file read
#   bound. Files larger than this (by listing) are skipped with a warning; a
#   stream that exceeds it mid-read is aborted.
# BDH_MAX_FILE_BYTES=1073741824

# BDH_IDENTITY_OBJECT (optional, default User): BDH object holding the
#   Salesforce user directory (Id, Email, Name, IsActive) for identity sync.
# BDH_IDENTITY_OBJECT=User

# ITEM_URL_BASE (optional, default https://login.salesforce.com): base URL for
#   result-card deep links — point it at your LIVE Salesforce org so cards
#   open the real record (ids are identical), e.g.
#   https://your-org.lightning.force.com.
# ITEM_URL_BASE=https://your-org.lightning.force.com


# -----------------------------------------------------------------------------
# AZURE AD / MICROSOFT GRAPH
# -----------------------------------------------------------------------------
# The app registration needs these APPLICATION Graph permissions (admin-consented):
#   ExternalConnection.ReadWrite.OwnedBy, ExternalItem.ReadWrite.OwnedBy,
#   User.Read.All (identity sync: email/UPN → Entra object id).
#
# AAD_APP_TENANT_ID (REQUIRED): Entra tenant ID.
AAD_APP_TENANT_ID=00000000-0000-0000-0000-000000000000

# AAD_APP_CLIENT_ID (REQUIRED): Entra application (client) ID.
AAD_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- SECRET: put this line in env/.env.local.user, NEVER here
# SECRET_AAD_APP_CLIENT_SECRET (REQUIRED unless a certificate credential is
#   configured below): Entra app client secret VALUE.
#   If USE_KEY_VAULT=true this may instead live in Key Vault (below).
# SECRET_AAD_APP_CLIENT_SECRET=your-entra-app-client-secret

# --- Certificate credential (recommended for production; docs/DEPLOYMENT_ENTERPRISE.md)
# When either knob below is set the connector authenticates to Entra with a
# signed client assertion (RS256 JWT, x5t#S256) INSTEAD of the client secret —
# the certificate always wins when both are configured. Only the auth MODE is
# ever logged.
#
# GRAPH_CLIENT_CERT_PATH (optional): PFX/PKCS#12 file (or PEM with cert+key).
# GRAPH_CLIENT_CERT_PASSWORD (optional): PFX password — SECRET-style: put it in
#   env/.env.local.user or Key Vault (graph-client-cert-password).
# GRAPH_CLIENT_CERT_THUMBPRINT (optional, Windows only): load from the
#   certificate store instead (CurrentUser\My then LocalMachine\My) so the
#   private key never touches disk. Grant the service account read access to
#   the private key.
# GRAPH_CLIENT_CERT_PATH=
# GRAPH_CLIENT_CERT_THUMBPRINT=

# --- Sovereign / national clouds (all optional; public-cloud defaults) ------
# GRAPH_BASE_URL (default https://graph.microsoft.com): Graph resource endpoint,
#   e.g. https://graph.microsoft.us (US Gov) or
#   https://microsoftgraph.chinacloudapi.cn (21Vianet).
# GRAPH_SCOPE (default <GRAPH_BASE_URL>/.default): token audience — set only if
#   your cloud's audience differs from the base URL.
# GRAPH_API_VERSION (default v1.0): v1.0 or beta.
# AAD_APP_OAUTH_AUTHORITY_HOST (default https://login.microsoftonline.com):
#   token authority host, e.g. https://login.microsoftonline.us.
# GRAPH_BASE_URL=https://graph.microsoft.com

# GRAPH_MAX_RETRIES (optional, default 4): retries on 429/500/502/503/504.
#   See docs/RETRY.md.
# GRAPH_RETRY_BACKOFF_BASE (optional, default 2): backoff base seconds
#   (base * 2^attempt; EVERY wait — server Retry-After included — is clamped
#   to 60s, and only numeric Retry-After values are trusted).


# -----------------------------------------------------------------------------
# CONNECTION & SCHEMA PROVISIONING
# -----------------------------------------------------------------------------
# CONNECTION_TIMEOUT_SECONDS (optional, default 600): max wait for connection /
#   schema provisioning.
# CONNECTION_RETRY_INTERVAL_SECONDS (optional, default 15): poll interval.


# -----------------------------------------------------------------------------
# BATCHING & PARALLELISM
# -----------------------------------------------------------------------------
# INGEST_CHUNK_SIZE (optional, default 200): records per checkpointed chunk.
# INGEST_GRAPH_BATCH_SIZE (optional, default 20): requests per Graph $batch
#   POST. Hard-capped at 20 by the API. GRAPH_BATCH_SIZE is an accepted alias
#   (explicit INGEST_GRAPH_BATCH_SIZE wins when both are set).
# GRAPH_BATCH_WORKERS (optional, default 8): concurrent Graph $batch workers.
#   Higher = more throughput but more 429s; adaptive concurrency dials it
#   1..max on 429s and ramps back after 3 clean windows. In HA_MODE set this
#   to (single-node value ÷ node count) — the Graph 429 quota is shared per
#   connection. NOTE: GRAPH_CONCURRENT_BATCHES is an alias and WINS if both
#   are set. See docs/RETRY.md and docs/SHARDING.md.
# GRAPH_BATCH_WORKERS=8
# GRAPH_CONCURRENT_BATCHES=8


# -----------------------------------------------------------------------------
# ACL ENGINE — coarse by design (BDH has no Salesforce sharing tables)
# -----------------------------------------------------------------------------
# Per-object ACL modes live in config/schema.json (aclMode / aclGroupId /
# ownerField / ownerEmailField): ownerOnly | group | public.
#
# BDH_ADMIN_GROUP_ID (optional, default unset): Entra group appended to every
#   resolved (non-public) ACL — an operators/admin grant.
# BDH_ADMIN_GROUP_ID=00000000-0000-0000-0000-0000000000ad

# FALLBACK_ACL_GROUP_ID (optional, default unset): Entra group granted when a
#   record resolves to ZERO principals. Unset → such records are skipped
#   (never ingested world-readable by accident). The fallback never WIDENS a
#   resolved ACL — it applies only when nothing resolved.
# FALLBACK_ACL_GROUP_ID=00000000-0000-0000-0000-0000000000fb

# IDENTITY_SYNC_ON_INCREMENTAL=false # true → identity sync on incremental
#                                    # crawls too (default: full crawls only)


# =============================================================================
# OPERATIONAL KNOBS — all OFF BY DEFAULT (unset == classic file/SQLite behaviour)
# =============================================================================

# -----------------------------------------------------------------------------
# SQL SERVER STATE BACKEND — docs/SQL_CONTRACT.md
# -----------------------------------------------------------------------------
# Moves identity store, checkpoints, sync timestamps and the dead-letter queue
# into a shared SQL Server database. Required for HA. Provision once with
# scripts/sql/create-database.sql.
#
# USE_SQL_SERVER=false
# SQL_CONNECTION_STRING=Server=tcp:bdh-ag-listener,1433;Database=HadoopConnector;User ID=bdh_app;Password=<in .env.local.user>;Encrypt=True
# SQL_USE_MANAGED_IDENTITY=false     # Entra Managed Identity token instead of SQL creds
# SQL_MAX_RETRIES=5                  # transient-fault retry (AG failover)

# -----------------------------------------------------------------------------
# HIGH AVAILABILITY (active-active) — docs/HA.md
# -----------------------------------------------------------------------------
# Requires USE_SQL_SERVER=true (startup fails fast otherwise). Every node runs
# the SAME --continuous command against the SAME database.
#
# HA_MODE=false
# NODE_ID=bdh-node-1                 # default: machine name; set explicitly in containers
# HA_CLAIM_TIMEOUT_SECONDS=300       # stale-heartbeat takeover threshold
# HA_HEARTBEAT_SECONDS=60            # heartbeat interval while working a claim

# -----------------------------------------------------------------------------
# RETRY / THROTTLING — docs/RETRY.md
# -----------------------------------------------------------------------------
# GRAPH_RETRY_JITTER=false           # true → ±20% jitter on COMPUTED backoff
#                                    # (server Retry-After never jittered).
#                                    # Strongly recommended on every HA node.

# -----------------------------------------------------------------------------
# ENTERPRISE NETWORK EGRESS (proxy + private CAs) — docs/DEPLOYMENT_ENTERPRISE.md
# -----------------------------------------------------------------------------
# Applied to every outbound HTTP client (WebHDFS, Graph, alert webhook). Both
# knobs FAIL FAST at startup naming the setting when misconfigured.
#
# PROXY_URL (optional): explicit corporate proxy for outbound HTTP(S).
# PROXY_BYPASS (optional): ;/,-separated host patterns that go DIRECT
#   ('*' wildcard). Typical: proxy for Graph, bypass for on-prem namenodes.
# PROXY_URL=http://proxy.corp.local:8080
# PROXY_BYPASS=*.hadoop.corp.local;namenode1;10.*
#
# CA_BUNDLE_PATH (optional): PEM bundle of ADDITIVE trust anchors. WebHDFS
#   endpoints behind internal TLS (namenode/datanodes, Knox) very often present
#   certificates from a PRIVATE enterprise CA — put that CA chain here instead
#   of touching the machine trust store. Also needed when a TLS-inspecting
#   proxy re-signs Graph traffic. Additive: public certs that already chain to
#   the system store still pass; hostname mismatches always fail.
# CA_BUNDLE_PATH=/etc/pki/bdh/private-ca-bundle.pem

# -----------------------------------------------------------------------------
# WINDOWS EVENT LOG MIRRORING — docs/SIEM.md
# -----------------------------------------------------------------------------
# EVENTLOG_ENABLED (optional, default false): mirror Warning/Error log lines +
#   lifecycle start/stop to the Application event log (source HadoopConnector)
#   for agent-based SIEM collection. No-op off-Windows; never throws. The
#   event SOURCE is registered by scripts/install-windows-service.ps1
#   (idempotent, needs elevation once).
# EVENTLOG_LEVEL (optional, default warnings+errors): info → also mirror Info.
# EVENTLOG_ENABLED=false
# EVENTLOG_LEVEL=

# -----------------------------------------------------------------------------
# DEAD-LETTER PAYLOAD PROTECTION — docs/THREAT_MODEL.md
# -----------------------------------------------------------------------------
# DEADLETTER_PAYLOAD_MODE (optional, default full): full | redacted.
#   full     — failed entries embed the exact externalItem request body (fast
#              diagnosis; the queue then holds record VALUES and must be
#              protected like the source data).
#   redacted — record values are stripped BEFORE writing: ids, object type,
#              error, property names, sizes and SHA-256 hashes are kept.
#              retry-failed is unaffected (it re-fetches from BDH by id).
#   An unrecognized value behaves as redacted (fails toward less exposure).
# DEADLETTER_PAYLOAD_MODE=full

# -----------------------------------------------------------------------------
# LOG RETENTION
# -----------------------------------------------------------------------------
# LOG_RETENTION_DAYS=0               # >0 prunes logs/{prefix}_{timestamp}/ run
#                                    # dirs older than N days at the start of
#                                    # every command and each continuous cycle.
#                                    # Root state files are never touched.

# -----------------------------------------------------------------------------
# AZURE KEY VAULT (secret resolution)
# -----------------------------------------------------------------------------
# When enabled, SECRET_* values are read from Key Vault. Vault secret name =
# env-var name lowercased with '_'→'-' (SECRET_HDFS_DELEGATION_TOKEN →
# secret-hdfs-delegation-token). Auth: DefaultAzureCredential. Fetch failures
# fall back to the env var when present.
#
# USE_KEY_VAULT=false
# KEY_VAULT_URI=https://your-vault.vault.azure.net/

# -----------------------------------------------------------------------------
# OBSERVABILITY — docs/OBSERVABILITY.md
# -----------------------------------------------------------------------------
# HEALTH_PORT=8080                   # >0 → serve /health, /ready, /metrics
# LOG_FORMAT=text                    # json → one JSON object per log line
# LOG_LEVEL=DEBUG                    # raise the floor for every sink
#                                    # (DEBUG|INFO|WARNING|ERROR; default DEBUG).
#                                    # The ingest hot path gates per-item debug
#                                    # strings on this (isEnabledFor semantics).
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/xxxx
# ALERT_DEADLETTER_THRESHOLD=0       # >0 → alert when dead-letter depth exceeds it

# -----------------------------------------------------------------------------
# UNIFIED DATA CLASSIFICATION — docs/CLASSIFICATION.md
# -----------------------------------------------------------------------------
# CLASSIFICATION=false               # true → stamp SensitivityLabel +
#                                    # DetectedCategories (PII/PCI/Secret scan,
#                                    # config/classification.json patterns,
#                                    # regex MatchTimeout-bounded)
# CLASSIFICATION_MANIFEST=false      # true → per-crawl classification JSONL
#                                    # under logs/ (Purview-aligned export)

# -----------------------------------------------------------------------------
# DELETION / TOMBSTONE SYNC — docs/DELETION_SYNC.md
# -----------------------------------------------------------------------------
# BDH has no deletion feed, so full crawls run an existence sweep: every
# successfully ingested item id is tracked in the item inventory
# (data/{CONNECTOR_ID}_inventory.db, or dbo.ItemInventory on SQL Server), and
# inventory ids missing from the full-crawl source are DELETEd from the Graph
# connection. Incremental crawls never sweep; row-capped (partial) fetches
# never sweep. `reconcile [--fix]` reports (and repairs) drift on demand.
#
# DELETION_SYNC (optional, default true): false → never delete; the inventory
#   is still maintained so reconcile keeps working.
# DELETION_SYNC=true

# DELETION_SYNC_MAX_PERCENT (optional, default 25): mass-deletion safety guard.
#   When more than this percentage of an object type's inventory would be
#   deleted in one sweep the sweep is SKIPPED with a warning +
#   `deletion_sweep_skipped` alert — protection against a source outage, a
#   truncated export or an over-tightened filter nuking the index. The guard
#   engages once the inventory holds >= 20 items, OR (at any size) whenever
#   the full crawl's source returned ZERO rows for the object type. 0 or 100
#   disables the percent guard explicitly; values outside [0, 100] fall back
#   to the default 25 with a warning (a negative value never silently disables
#   the guard). `reconcile --fix` bypasses it (explicit operator intent).
# DELETION_SYNC_MAX_PERCENT=25

# DELETION_SYNC_MAX_ITEMS (optional, default 1000): absolute mass-deletion cap.
#   Never auto-delete more than this many items of one object type in a single
#   sweep, regardless of inventory size — this also guards small object types
#   the percent guard's >= 20-item floor does not cover. 0 disables the cap
#   explicitly; a negative value falls back to the default with a warning.
# DELETION_SYNC_MAX_ITEMS=1000

# -----------------------------------------------------------------------------
# CONNECTION SHARDING — docs/SHARDING.md (essential at BDH scale)
# -----------------------------------------------------------------------------
# GRAPH_CONNECTION_SHARDS (optional, default unset): JSON mapping each Graph
#   connection id to the object types it owns. When set, each shard is its own
#   Graph connection + schema and ingests only its object types (the rate
#   limit is per connection, so k shards ≈ k × single-connection throughput).
#   Every schema.json object must be assigned to exactly one shard (no dups,
#   no unknowns) — validate-config checks this in preflight.
# GRAPH_CONNECTION_SHARDS={"bdhCrmCore":["Contact","Account"],"bdhCrmPipeline":["Opportunity","Case","Lead"]}

# -----------------------------------------------------------------------------
# DISTRIBUTED TRACING (OpenTelemetry) — docs/TRACING.md
# -----------------------------------------------------------------------------
# When OTEL_EXPORTER_OTLP_ENDPOINT is set, the connector exports spans around
# the crawl cycle, per-object crawl, source fetch, transform, Graph ingest and
# deletion sweep, and stamps a correlation id on every log line + dead-letter
# record + span so one run is followable end-to-end. Unset = no exporter, no
# listener, a genuine no-op (default overhead unchanged). Export is batched /
# fire-and-forget — an unreachable collector never stalls a crawl. Standard
# OTEL env vars are honoured:
#
# OTEL_EXPORTER_OTLP_ENDPOINT (optional, default off): collector endpoint;
#   setting it enables tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# OTEL_EXPORTER_OTLP_PROTOCOL (optional, default grpc): grpc | http/protobuf.
# OTEL_EXPORTER_OTLP_HEADERS (optional): extra export headers, e.g. auth=Bearer...
# OTEL_SERVICE_NAME (optional, default = CONNECTOR_NAME): service.name resource.
# OTEL_SERVICE_NAME=bdh-copilot-connector

# -----------------------------------------------------------------------------
# CIRCUIT BREAKERS & DEGRADED MODE — docs/RESILIENCE.md
# -----------------------------------------------------------------------------
# A breaker per external dependency (hdfs, graph) fails fast during a
# SUSTAINED outage and pauses the crawl at a safe checkpoint boundary (no state
# loss), auto-recovering when half-open probes succeed. Only real failures
# (5xx/timeout/connection) count — 4xx and honoured 429 do not. On by default
# but inert on the happy path.
#
# CIRCUIT_BREAKER (optional, default true): false = pure passthrough (breakers
#   never engage; guaranteed-unchanged escape hatch).
# CIRCUIT_BREAKER=true

# CIRCUIT_BREAKER_FAILURE_THRESHOLD (optional, default 5): real failures within
#   the window before tripping to open.
# CIRCUIT_BREAKER_WINDOW_SECONDS (optional, default 60): rolling sample window.
# CIRCUIT_BREAKER_OPEN_SECONDS (optional, default 30): open duration before a
#   half-open probe is admitted (also the bounded degraded-retry backoff).
# CIRCUIT_BREAKER_HALF_OPEN_TRIALS (optional, default 2): probe successes needed
#   to close (and concurrent probes admitted in half-open).
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_OPEN_SECONDS=30
