<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.4.83" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.78.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HadoopConnector\HadoopConnector.csproj" />
  </ItemGroup>

  <!-- Real config assets used by fixture-based tests; several test classes swap
       process-global seams (SyncState.LogsDir, env vars, Logging), so test
       collections must not run in parallel. -->
  <ItemGroup>
    <Content Include="..\..\config\**" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- Chassis migration aliases: migrated types resolve to the chassis by simple
       name so call sites are untouched; not-yet-migrated local types don't collide. -->
  <ItemGroup>
    <Using Include="Connector.Chassis.EnvFlags" Alias="EnvFlags" />
    <Using Include="Connector.Chassis.ServiceStop" Alias="ServiceStop" />
    <Using Include="Connector.Chassis.Alerting" Alias="Alerting" />
    <Using Include="Connector.Chassis.SecretProvider" Alias="SecretProvider" />
    <Using Include="Connector.Chassis.Logging" Alias="Logging" />
    <Using Include="Connector.Chassis.IAppLogger" Alias="IAppLogger" />
    <Using Include="Connector.Chassis.LogLevel" Alias="LogLevel" />
    <Using Include="Connector.Chassis.ISqlGateway" Alias="ISqlGateway" />
    <Using Include="Connector.Chassis.SqlGateway" Alias="SqlExecutor" />
  </ItemGroup>

</Project>
