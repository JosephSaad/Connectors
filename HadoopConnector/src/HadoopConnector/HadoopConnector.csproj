<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HadoopConnector.Tests" />
    <InternalsVisibleTo Include="StressHarness" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Explicit bump past the SQLitePCLRaw 2.1.11 advisory (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <!-- Windows Event Log mirroring (EVENTLOG_ENABLED, docs/SIEM.md). The
         package is a no-op facade off-Windows, matching EventLogSink. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <!-- Distributed tracing (docs/TRACING.md). Registered only when
         OTEL_EXPORTER_OTLP_ENDPOINT is set; a cheap no-op otherwise. -->
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <!-- The chassis lives in this repository, so it is referenced as a project
         rather than a published package: a clean clone builds with no feed, no
         pack step and no version to keep in sync. -->
    <ProjectReference Include="..\..\..\Connector.Chassis\Connector.Chassis.csproj" />
  </ItemGroup>


  <!-- Chassis migration aliases: migrated types resolve to the chassis by simple
       name so call sites are untouched; not-yet-migrated local types don't collide. -->
  <ItemGroup>
    <Using Include="Connector.Chassis.ServiceStop" Alias="ServiceStop" />
    <Using Include="Connector.Chassis.SecretProvider" Alias="SecretProvider" />
    <Using Include="Connector.Chassis.Logging" Alias="Logging" />
    <Using Include="Connector.Chassis.IAppLogger" Alias="IAppLogger" />
    <Using Include="Connector.Chassis.LogLevel" Alias="LogLevel" />
    <Using Include="Connector.Chassis.ISqlGateway" Alias="ISqlGateway" />
    <Using Include="Connector.Chassis.SqlGateway" Alias="SqlExecutor" />
  </ItemGroup>

</Project>
