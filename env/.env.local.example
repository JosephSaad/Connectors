# =============================================================================
# Salesforce Copilot Connector — environment template
# =============================================================================
# HOW TO USE THIS FILE
#   1. Copy it to env/.env.local           (non-secret config, may be per-node)
#   2. Put every SECRET_* value in         env/.env.local.user
#   3. NEVER commit .env.local or .env.local.user — only this .example is tracked.
#      (.gitignore already excludes both; env/README.md explains the split.)
#
# Both files are loaded automatically from env/.env.local and env/.env.local.user
# (and, as a fallback, ./.env.local and ./.env.local.user in the repo root).
# Values already present in the real process environment win over these files,
# so container/Windows-service env blocks can override anything here.
#
# CONVENTIONS
#   • Uncommented lines below are the variables the connector reads.
#   • "REQUIRED" variables must be set or startup fails with
#     "Invalid configuration: Missing <NAME>".
#   • Optional variables show their built-in default in the comment; leave them
#     unset to keep that default. Every operational knob in the last sections is
#     OFF BY DEFAULT — unset means "behave exactly like the classic file/SQLite
#     connector".
#   • Booleans are truthy for: true / 1 / yes (case-insensitive). Anything else
#     (including empty) is false.
#
# Authoritative sources for the names/defaults below: env/README.md,
# Salesforce/Settings.cs, docs/SQL_CONTRACT.md, docs/HA.md, docs/RETRY.md,
# and docs/IMPROVEMENTS_CONTRACT.md. `dotnet run --project src/... -- guide`
# prints a shorter version of the same reference.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE / IDENTITY  (all REQUIRED)
# -----------------------------------------------------------------------------
# CONNECTOR_ID: unique ID for the Graph external connection. 3–32 chars,
#   alphanumeric only (no spaces/punctuation), and must NOT start with a reserved
#   Microsoft prefix (Microsoft, SharePoint, Teams, Exchange, OneDriveBusiness,
#   LinkedIn, Yammer, Connectors, PowerBI, ... — see Settings.cs for the full
#   list). Used as the on-disk state key (data/{CONNECTOR_ID}_identity.db,
#   logs/checkpoint_{CONNECTOR_ID}.json, logs/failed_records_{CONNECTOR_ID}.jsonl).
CONNECTOR_ID=SalesforceCRM

# CONNECTOR_NAME: human-readable display name shown in the Microsoft admin UI.
CONNECTOR_NAME=Salesforce CRM

# CONNECTOR_DESCRIPTION: short description shown in Microsoft Search.
CONNECTOR_DESCRIPTION=Salesforce CRM records synced to Microsoft 365 Copilot.

# TEAMSFX_ENV: environment label. When set to "local" the connector sets
#   AZURE_FUNCTIONS_ENVIRONMENT=Development for you (matches the Python original).
TEAMSFX_ENV=local

# APP_NAME_SUFFIX: suffix appended to app names (e.g. local / dev / prod).
APP_NAME_SUFFIX=local


# -----------------------------------------------------------------------------
# SALESFORCE
# -----------------------------------------------------------------------------
# SALESFORCE_INSTANCE_URL (REQUIRED): your Salesforce org URL (trailing slash OK).
SALESFORCE_INSTANCE_URL=https://your-org.my.salesforce.com/

# SALESFORCE_API_VERSION (REQUIRED): Salesforce REST API version, e.g. v60.0.
SALESFORCE_API_VERSION=v60.0

# SALESFORCE_CLIENT_ID (REQUIRED): Connected App Consumer Key (OAuth 2.0
#   client-credentials flow).
SALESFORCE_CLIENT_ID=your-connected-app-consumer-key

# --- SECRET: put this line in env/.env.local.user, NEVER here / never committed
# SECRET_SALESFORCE_CLIENT_SECRET (REQUIRED): Connected App Consumer Secret.
# SECRET_SALESFORCE_CLIENT_SECRET=your-connected-app-consumer-secret

# SALESFORCE_QUERY_LIMIT (optional, default 0): SOQL LIMIT clause.
#   0 = full pagination (production). Set a small number for dev/debug only.
# SALESFORCE_QUERY_LIMIT=0

# SALESFORCE_BATCH_SIZE (optional, default 100): max record IDs per SOQL IN clause.
# SALESFORCE_BATCH_SIZE=100


# -----------------------------------------------------------------------------
# AZURE AD / MICROSOFT GRAPH
# -----------------------------------------------------------------------------
# The app registration needs these APPLICATION Graph permissions (admin-consented):
#   ExternalConnection.ReadWrite.OwnedBy  and  ExternalItem.ReadWrite.OwnedBy
#
# AAD_APP_CLIENT_ID (REQUIRED): Entra application (client) ID.
AAD_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# AAD_APP_OBJECT_ID (REQUIRED): Entra application object ID.
AAD_APP_OBJECT_ID=00000000-0000-0000-0000-000000000000

# AAD_APP_TENANT_ID (REQUIRED): Entra tenant ID.
AAD_APP_TENANT_ID=00000000-0000-0000-0000-000000000000

# AAD_APP_OAUTH_AUTHORITY (REQUIRED): full OAuth authority URL.
AAD_APP_OAUTH_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000

# AAD_APP_OAUTH_AUTHORITY_HOST (REQUIRED): OAuth authority host.
AAD_APP_OAUTH_AUTHORITY_HOST=https://login.microsoftonline.com

# --- SECRET: put this line in env/.env.local.user, NEVER here / never committed
# SECRET_AAD_APP_CLIENT_SECRET (REQUIRED): Entra app client secret VALUE (not the
#   secret ID). If USE_KEY_VAULT=true this may instead live in Key Vault (below).
# SECRET_AAD_APP_CLIENT_SECRET=your-entra-app-client-secret

# GRAPH_API_VERSION (optional, default beta): Graph API version — v1.0 or beta.
#   NOTE: env/README.md documents the default as `beta`; Settings.cs falls back to
#   `v1.0` when unset. Set it explicitly to avoid ambiguity.
# GRAPH_API_VERSION=v1.0

# GRAPH_MAX_RETRIES (optional, default 4): max retries on Graph API failures
#   (429/5xx). See docs/RETRY.md.
# GRAPH_MAX_RETRIES=4

# GRAPH_RETRY_BACKOFF_BASE (optional, default 2): exponential backoff base, in
#   seconds (base * 2^attempt, capped at 60s; server Retry-After honoured exactly).
# GRAPH_RETRY_BACKOFF_BASE=2


# -----------------------------------------------------------------------------
# CONNECTION & SCHEMA PROVISIONING
# -----------------------------------------------------------------------------
# CONNECTION_TIMEOUT_SECONDS (optional, default 600): max wait for the external
#   connection to finish provisioning.
# CONNECTION_TIMEOUT_SECONDS=600

# CONNECTION_RETRY_INTERVAL_SECONDS (optional, default 15): poll interval for
#   connection status.
# CONNECTION_RETRY_INTERVAL_SECONDS=15

# SCHEMA_RETRY_INTERVAL_SECONDS (optional, default 15): poll interval for schema
#   provisioning.
# SCHEMA_RETRY_INTERVAL_SECONDS=15


# -----------------------------------------------------------------------------
# BATCHING & PARALLELISM
# -----------------------------------------------------------------------------
# INGEST_CHUNK_SIZE (optional, default 2000): Salesforce records per
#   ACL + Graph $batch cycle. Align to 2000 (one SF page); safe up to ~5000.
# INGEST_CHUNK_SIZE=2000

# INGEST_GRAPH_BATCH_SIZE (optional, default 20): requests per Graph $batch POST.
#   Hard-capped at 20 by the API (values above 20 are clamped to 20).
# INGEST_GRAPH_BATCH_SIZE=20

# GRAPH_BATCH_WORKERS (optional, default 8): concurrent Graph $batch workers.
#   Higher = more throughput but more 429s; adaptive concurrency dials it 1..max
#   on 429s. In HA_MODE set this to (single-node value ÷ node count) — the Graph
#   429 quota is shared per connection. See docs/HA.md and docs/CAPACITY.md.
#   NOTE: GRAPH_CONCURRENT_BATCHES is an alias and WINS if both are set.
# GRAPH_BATCH_WORKERS=8
# GRAPH_CONCURRENT_BATCHES=8

# PARALLEL_OBJECT_WORKERS (optional, default 3): Salesforce object types ingested
#   in parallel (single-node/non-HA path). In HA_MODE, object types are instead
#   claimed one at a time per node via SQL coordination.
# PARALLEL_OBJECT_WORKERS=3


# -----------------------------------------------------------------------------
# ACL ENGINE
# -----------------------------------------------------------------------------
# See docs/ACL_PERMISSION_DFD.md for the permission model this controls.
#
# USE_NEW_ACL_ENGINE (optional, default true): use the modular ACL engine
#   (AclEngine/) instead of the legacy resolver (Graph/LegacyAclResolver.cs).
# USE_NEW_ACL_ENGINE=true

# USE_GROUP_ACL (optional, default true): enable group-based ACLs (public groups,
#   queues, roles, territories). Requires an identity crawl before content;
#   full-deployment runs it for you.
# USE_GROUP_ACL=true

# ACL_MAX_PARENT_DEPTH (optional, default 5): max depth when following
#   ControlledByParent ACL chains.
# ACL_MAX_PARENT_DEPTH=5

# OWD_OVERRIDES (optional, default empty): force specific Org-Wide Default values
#   for testing. JSON object, e.g. {"Account":"Private"}. Invalid JSON is ignored.
# OWD_OVERRIDES={"Account":"Private"}

# USE_ENTITY_DEFINITION_OWD (optional, default false): read OWD from the
#   EntityDefinition metadata instead of the schema.json owdField mapping.
# USE_ENTITY_DEFINITION_OWD=false


# =============================================================================
# OPERATIONAL KNOBS  — all OFF BY DEFAULT (unset == classic file/SQLite behaviour)
# =============================================================================

# -----------------------------------------------------------------------------
# SQL SERVER STATE BACKEND
# -----------------------------------------------------------------------------
# Moves identity store, checkpoints, sync timestamps and the dead-letter queue
# from files/SQLite into a shared SQL Server database. Required for HA. Provision
# the DB once with scripts/sql/create-database.sql + create-login.sql.
# Contract: docs/SQL_CONTRACT.md.
#
# USE_SQL_SERVER (optional, default false): true → use SQL Server for all state.
# USE_SQL_SERVER=false

# SQL_CONNECTION_STRING: REQUIRED when USE_SQL_SERVER=true. For HA point it at the
#   Always On AG LISTENER, not an individual replica. The connector forces
#   Encrypt=True unless the string already sets Encrypt.
# SQL_CONNECTION_STRING=Server=tcp:sfc-ag-listener,1433;Database=SalesforceConnector;User ID=sfc_app;Password=<in .env.local.user>;Encrypt=True

# SQL_USE_MANAGED_IDENTITY (optional, default false): true → authenticate to SQL
#   with an Entra Managed Identity token instead of connection-string credentials
#   (drop the User ID/Password from SQL_CONNECTION_STRING when using this).
# SQL_USE_MANAGED_IDENTITY=false

# SQL_MAX_RETRIES (optional, default 5): transient-fault retry count for SQL ops
#   (exponential backoff; honours known transient/AG-failover error numbers).
# SQL_MAX_RETRIES=5

# --- If SQL auth uses a password and you keep it out of the connection string,
#     store the password itself in env/.env.local.user, not here.


# -----------------------------------------------------------------------------
# HIGH AVAILABILITY (active-active)  — see docs/HA.md
# -----------------------------------------------------------------------------
# Requires USE_SQL_SERVER=true (startup fails fast otherwise). Every node runs the
# SAME --continuous command against the SAME database and coordinates through SQL.
#
# HA_MODE (optional, default false): true → multi-node crawl coordination.
# HA_MODE=false

# NODE_ID (optional, default = machine name): stable, unique per node. Appears in
#   ObjectClaims / vActiveCrawls. Set it explicitly in containers (machine name is
#   random there).
# NODE_ID=sfc-node-1

# HA_CLAIM_TIMEOUT_SECONDS (optional, default 300): a claim whose heartbeat is
#   older than this is reclaimable by another node. Keep comfortably >
#   HA_HEARTBEAT_SECONDS.
# HA_CLAIM_TIMEOUT_SECONDS=300

# HA_HEARTBEAT_SECONDS (optional, default 60): heartbeat interval while a node
#   works an object claim.
# HA_HEARTBEAT_SECONDS=60


# -----------------------------------------------------------------------------
# RETRY / THROTTLING  — see docs/RETRY.md
# -----------------------------------------------------------------------------
# GRAPH_RETRY_JITTER (optional, default false): true → apply ±20% jitter to
#   COMPUTED Graph retry backoff (server Retry-After is never jittered). Strongly
#   recommended on every node in HA so throttled nodes don't retry in lockstep.
# GRAPH_RETRY_JITTER=false


# -----------------------------------------------------------------------------
# LOG RETENTION
# -----------------------------------------------------------------------------
# LOG_RETENTION_DAYS (optional, default 0 = keep forever): > 0 prunes
#   logs/{prefix}_{timestamp}/ run directories (and, with USE_SQL_SERVER=true, SQL
#   dead-letter/session/crawl history via usp_PruneHistory) older than N days at
#   the start of every command and each --continuous cycle. Root state files
#   (sync_state.json, checkpoint_*.json, failed_records_*.jsonl) are never touched.
# LOG_RETENTION_DAYS=0


# -----------------------------------------------------------------------------
# AZURE KEY VAULT  (secret resolution)  — see docs/IMPROVEMENTS_CONTRACT.md #7
# -----------------------------------------------------------------------------
# When enabled, SECRET_* values are read from Key Vault instead of the
# environment. The vault secret name = the env-var name lowercased with '_'→'-'
# (e.g. SECRET_AAD_APP_CLIENT_SECRET → secret-aad-app-client-secret). Auth uses
# DefaultAzureCredential (Managed Identity, env creds, Azure CLI, ...). On a fetch
# failure it falls back to the env var if present.
#
# USE_KEY_VAULT (optional, default false): true → resolve SECRET_* from Key Vault.
# USE_KEY_VAULT=false

# KEY_VAULT_URI: REQUIRED when USE_KEY_VAULT=true. The vault URL.
# KEY_VAULT_URI=https://your-vault.vault.azure.net/


# -----------------------------------------------------------------------------
# OBSERVABILITY  (health / metrics / structured logs / alerting)
# -----------------------------------------------------------------------------
# See docs/OBSERVABILITY.md (and docs/IMPROVEMENTS_CONTRACT.md #9/#10/#11).
#
# HEALTH_PORT (optional, default 0 = disabled): > 0 → serve /health, /ready and
#   /metrics (Prometheus text) on that port.
# HEALTH_PORT=8080

# LOG_FORMAT (optional, default text): json → emit one JSON object per log line
#   (timestamp/level/logger/message). Otherwise human-readable text.
# LOG_FORMAT=text

# ALERT_WEBHOOK_URL (optional, default unset): POST a JSON alert on crawl failure
#   and when the dead-letter depth crosses ALERT_DEADLETTER_THRESHOLD.
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/xxxx

# ALERT_DEADLETTER_THRESHOLD (optional, default 0 = off): > 0 → alert when the
#   dead-letter queue depth exceeds this many records.
# ALERT_DEADLETTER_THRESHOLD=0


# -----------------------------------------------------------------------------
# INCREMENTAL IDENTITY SYNC  — see docs/IMPROVEMENTS_CONTRACT.md #12
# -----------------------------------------------------------------------------
# IDENTITY_SYNC_ON_INCREMENTAL (optional, default false): true → also run an
#   identity sync on incremental content crawls (default runs identity only on
#   full crawls). Uses the identity store's last-session watermark.
# IDENTITY_SYNC_ON_INCREMENTAL=false


# -----------------------------------------------------------------------------
# CONNECTION SHARDING  — see docs/IMPROVEMENTS_CONTRACT.md #2
# -----------------------------------------------------------------------------
# GRAPH_CONNECTION_SHARDS (optional, default unset): JSON mapping each Graph
#   connection ID to the object types it owns. When set, each shard is its own
#   Graph connection + schema and ingests only its object types (rate limit #1 is
#   per connection, so k shards ≈ k × the single-connection throughput). Every
#   schema.json object must be assigned to exactly one shard (no dups, no
#   unknowns). See docs/CAPACITY.md §6.
# GRAPH_CONNECTION_SHARDS={"SalesforceCoreCRM":["Account","Contact","Lead"],"SalesforceCases":["Case"]}
