<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StressHarness</AssemblyName>
    <RootNamespace>StressHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Connector.Chassis.LogLevels" Alias="LogLevels" />
    <Using Include="Connector.Chassis.LogRecord" Alias="LogRecord" />
    <Using Include="Connector.Chassis.SecretProvider" Alias="SecretProvider" />
    <Using Include="Connector.Chassis.ServiceStop" Alias="ServiceStop" />
    <Using Include="Connector.Chassis.Alerting" Alias="Alerting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SalesforceCopilotConnector\SalesforceCopilotConnector.csproj" />
  </ItemGroup>

  <!-- Real schema/config assets: Settings.RepoRoot is CWD-based; when the harness is
       launched from somewhere other than the repo root it falls back to the copy in
       its own output directory (see Program.Main). -->
  <ItemGroup>
    <Content Include="..\..\config\**" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
