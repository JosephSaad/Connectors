<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.117.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Connector.Chassis.EnvFlags" Alias="EnvFlags" />
    <Using Include="Connector.Chassis.SecretProvider" Alias="SecretProvider" />
    <Using Include="Connector.Chassis.LogLevels" Alias="LogLevels" />
    <Using Include="Connector.Chassis.LogRecord" Alias="LogRecord" />
    <Using Include="Connector.Chassis.ServiceHost" Alias="ServiceHost" />
    <Using Include="Connector.Chassis.ServiceStop" Alias="ServiceStop" />
    <Using Include="Connector.Chassis.Alerting" Alias="Alerting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SalesforceCopilotConnector\SalesforceCopilotConnector.csproj" />
  </ItemGroup>

  <!-- Real schema/config assets used by TestFixtures (Settings.RepoRoot is CWD-based,
       and the xUnit runner's CWD is the output directory). -->
  <ItemGroup>
    <Content Include="..\..\config\**" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Several test classes swap process-global seams (Ingest hooks, SyncState.LogsDir,
         ApiClient.SfSession, env vars); collections must not run in parallel. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
