<?xml version="1.0" encoding="UTF-8"?>
<!--
  Salesforce Copilot Connector - WiX v5 MSI (EXPERIMENTAL)

  Built by the `msi` job in .github/workflows/release.yml on a windows runner:

    wix build packaging/msi/SalesforceConnector.wxs -arch x64
        -d PublishDir=publish/win-x64 -d RepoRoot=. -d ProductVersion=1.0.0
        -o out/SalesforceCopilotConnector-<version>-x64.msi

  What it installs (perMachine, ProgramFiles64):
    - the self-contained single-file exe
    - config\  template JSONs (schema/graph-schema/template)
    - env\     .env.local.example + README (the real .env.local / .env.local.user
               are DEPLOYED SEPARATELY - SCCM/Intune/GPO; see docs/DEPLOYMENT_ENTERPRISE.md)
    - the Windows service (Automatic/delayed, NOT started by the installer:
      first start needs a populated env\.env.local)
    - SFCONNECTOR_HOME service environment (registry MultiString on the service key)
    - the "SalesforceConnector" Application event-log source, created via the
      EventLog registry key (equivalent to EventLog.CreateEventSource, no custom
      action needed; idempotent by MSI component rules)

  Deliberately NOT in the MSI: crash-restart failure actions (run
  `sc.exe failure SalesforceCopilotConnector reset= 86400 actions= restart/30000/restart/60000/restart/300000`
  as a post-step, exactly like scripts/install-windows-service.ps1), and any
  secret material. Uninstall leaves logs\ and data\ behind (state survives
  reinstalls; remove manually to purge).

  UpgradeCode is the product's PERMANENT identity - never change it, or
  upgrades stop detecting existing installs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Salesforce Copilot Connector"
      Manufacturer="Clouds Connected Ltd"
      Version="$(var.ProductVersion)"
      UpgradeCode="7f2b9a4e-5c1d-4b8e-9f3a-2d6c8e0b4a71"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Salesforce Copilot Connector is already installed."
        Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Stop the service before file replacement on upgrades; uninstall removes it. -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SalesforceCopilotConnector">
        <Directory Id="ConfigFolder" Name="config" />
        <Directory Id="EnvFolder" Name="env" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Connector" Title="Salesforce Copilot Connector" Level="1">
      <ComponentGroupRef Id="ConnectorBinaries" />
      <ComponentGroupRef Id="ConnectorConfigTemplates" />
      <ComponentGroupRef Id="ConnectorRegistry" />
    </Feature>

    <ComponentGroup Id="ConnectorBinaries" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="ConnectorExe"
              Source="$(var.PublishDir)\SalesforceCopilotConnector.exe"
              KeyPath="yes" />
        <!-- The app is SCM-aware: the binary path just carries the CLI command.
             Start is Automatic (delayed) but the installer does NOT start it -
             env\.env.local must be provisioned first. -->
        <ServiceInstall Id="ConnectorService"
                        Name="SalesforceCopilotConnector"
                        DisplayName="Salesforce Copilot Connector"
                        Description="Microsoft 365 Copilot custom connector for Salesforce CRM (full-deployment --continuous)"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="full-deployment --continuous --full-crawl-hours 24 --incremental-hours 4"
                        Vital="yes">
          <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
        </ServiceInstall>
        <ServiceControl Id="ConnectorServiceControl"
                        Name="SalesforceCopilotConnector"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConnectorConfigTemplates">
      <Component Id="ConfigSchema" Directory="ConfigFolder">
        <File Id="ConfigSchemaJson" Source="$(var.RepoRoot)\config\schema.json" KeyPath="yes" />
      </Component>
      <Component Id="ConfigGraphSchema" Directory="ConfigFolder">
        <File Id="ConfigGraphSchemaJson" Source="$(var.RepoRoot)\config\graph-schema.json" KeyPath="yes" />
      </Component>
      <Component Id="ConfigTemplate" Directory="ConfigFolder">
        <File Id="ConfigTemplateJson" Source="$(var.RepoRoot)\config\template.json" KeyPath="yes" />
      </Component>
      <Component Id="EnvExample" Directory="EnvFolder">
        <File Id="EnvLocalExample" Source="$(var.RepoRoot)\env\.env.local.example" KeyPath="yes" />
      </Component>
      <Component Id="EnvReadme" Directory="EnvFolder">
        <File Id="EnvReadmeMd" Source="$(var.RepoRoot)\env\README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConnectorRegistry" Directory="INSTALLFOLDER">
      <!-- config/, env/, logs/, data/ resolve against SFCONNECTOR_HOME
           (services start in System32). Same mechanism as install-windows-service.ps1. -->
      <Component Id="ServiceEnvironment">
        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\SalesforceCopilotConnector">
          <RegistryValue Name="Environment" Type="multiString" KeyPath="yes">
            <MultiString Value="SFCONNECTOR_HOME=[INSTALLFOLDER]" />
          </RegistryValue>
        </RegistryKey>
      </Component>
      <!-- Event-log source for EVENTLOG_ENABLED=true (Infrastructure/EventLogSink.cs).
           Registry form of EventLog.CreateEventSource("SalesforceConnector","Application"):
           no custom action, removed cleanly on uninstall. -->
      <Component Id="EventLogSource">
        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\SalesforceConnector">
          <RegistryValue Name="EventMessageFile"
                         Type="expandable"
                         Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll"
                         KeyPath="yes" />
          <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
