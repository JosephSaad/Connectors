<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Connector.Chassis</PackageId>
    <Version>1.20.0</Version>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The chassis's own suite. First in the list because it is the only one
         that tests these internals directly rather than through a connector. -->
    <InternalsVisibleTo Include="Connector.Chassis.Tests" />
    <InternalsVisibleTo Include="SeismicConnector.Tests" />
    <InternalsVisibleTo Include="ClarizenConnector.Tests" />
    <InternalsVisibleTo Include="HadoopConnector.Tests" />
    <InternalsVisibleTo Include="SalesforceCopilotConnector.Tests" />
    <InternalsVisibleTo Include="AltrataConnector.Tests" />
    <InternalsVisibleTo Include="StressHarness" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
  </ItemGroup>

</Project>
