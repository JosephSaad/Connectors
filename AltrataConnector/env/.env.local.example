# =============================================================================
# Altrata Copilot Connector — environment template
# =============================================================================
# HOW TO USE THIS FILE
#   1. Copy it to env/.env.local           (non-secret config, may be per-node)
#   2. Put every SECRET_* value in         env/.env.local.user
#   3. NEVER commit .env.local or .env.local.user — only this .example is tracked.
#
# Both files are loaded automatically from env/.env.local and env/.env.local.user
# (and, as a fallback, ./.env.local and ./.env.local.user in the repo root).
# Values already present in the real process environment win over these files,
# so container/Windows-service env blocks can override anything here.
#
# CONVENTIONS
#   • "REQUIRED" variables must be set or startup fails with
#     "Invalid configuration: Missing <NAME>".
#   • Optional variables show their built-in default; leave them unset to keep
#     it. Every operational knob is OFF BY DEFAULT.
#   • Booleans are truthy for: true / 1 / yes (case-insensitive).
# =============================================================================


# -----------------------------------------------------------------------------
# CORE / IDENTITY  (all REQUIRED)
# -----------------------------------------------------------------------------
# CONNECTOR_ID: unique ID for the Graph external connection. 3-32 chars,
#   alphanumeric only, must NOT start with a reserved Microsoft prefix
#   (Microsoft, SharePoint, Teams, Exchange, ...). Also the on-disk state key:
#   data/{CONNECTOR_ID}_identity.db, data/{CONNECTOR_ID}_state.json,
#   logs/checkpoint_{CONNECTOR_ID}.json, logs/failed_records_{CONNECTOR_ID}.jsonl,
#   logs/audit_{CONNECTOR_ID}.jsonl.
CONNECTOR_ID=AltrataWealth

# CONNECTOR_NAME: display name shown in the Microsoft admin UI.
CONNECTOR_NAME=Altrata Wealth Intelligence

# CONNECTOR_DESCRIPTION: short description shown in Microsoft Search.
CONNECTOR_DESCRIPTION=Altrata relationship and wealth intelligence synced to Microsoft 365 Copilot (licensed seats only).


# -----------------------------------------------------------------------------
# AZURE AD / MICROSOFT GRAPH
# -----------------------------------------------------------------------------
# The app registration needs these APPLICATION Graph permissions (admin consent):
#   ExternalConnection.ReadWrite.OwnedBy  and  ExternalItem.ReadWrite.OwnedBy
#
# AAD_APP_CLIENT_ID (REQUIRED): Entra application (client) ID.
AAD_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# AAD_APP_TENANT_ID (REQUIRED): Entra tenant ID.
AAD_APP_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- SECRET: put this line in env/.env.local.user, NEVER here
# SECRET_AAD_APP_CLIENT_SECRET (REQUIRED): Entra app client secret VALUE.
#   With USE_KEY_VAULT=true this may instead live in Key Vault as
#   secret-aad-app-client-secret.
# SECRET_AAD_APP_CLIENT_SECRET=your-entra-app-client-secret

# GRAPH_API_VERSION (optional, default v1.0): v1.0 or beta.
# GRAPH_API_VERSION=v1.0

# GRAPH_BASE_URL (optional, default https://graph.microsoft.com): sovereign/
#   national cloud Graph endpoint, e.g. https://graph.microsoft.us (US Gov) or
#   https://microsoftgraph.chinacloudapi.cn (21Vianet). Unset = public cloud,
#   byte-identical behaviour. docs/RETRY.md "Sovereign clouds".
# GRAPH_BASE_URL=https://graph.microsoft.us

# GRAPH_SCOPE (optional, default {GRAPH_BASE_URL}/.default): token audience.
#   Only needed when the audience differs from the base URL default.
# GRAPH_SCOPE=https://graph.microsoft.us/.default

# GRAPH_MAX_RETRIES (optional, default 4): max retries on 429/5xx. docs/RETRY.md.
# GRAPH_MAX_RETRIES=4

# GRAPH_RETRY_BACKOFF_BASE (optional, default 2): exponential backoff base in
#   seconds (base * 2^attempt, capped at 60s; server Retry-After honoured
#   exactly but clamped to the same 60s cap).
# GRAPH_RETRY_BACKOFF_BASE=2

# GRAPH_RETRY_JITTER (optional, default false): ±20% jitter on COMPUTED backoff
#   delays only (never on Retry-After). Recommended true in HA. docs/RETRY.md.
# GRAPH_RETRY_JITTER=false

# GRAPH_BATCH_SIZE (optional, default 20, max 20): requests per Graph $batch
#   call. A superchunk of GRAPH_BATCH_SIZE * GRAPH_BATCH_WORKERS records is the
#   checkpoint granularity and the graceful-stop flush unit.
# GRAPH_BATCH_SIZE=20

# GRAPH_BATCH_WORKERS (optional, default 8): concurrent Graph $batch workers.
#   Adaptive: dials down on 429 (floor 1), ramps back up after 3 clean batches.
#   NOTE: GRAPH_CONCURRENT_BATCHES is an alias and WINS if both are set.
# GRAPH_BATCH_WORKERS=8
# GRAPH_CONCURRENT_BATCHES=8

# GRAPH_CONNECTION_SHARDS (optional, default off): multi-connection sharding —
#   JSON object mapping connection ids to the datasets they own. Must
#   partition ALL datasets exactly; a bad map ABORTS the crawl. docs/SHARDING.md.
# GRAPH_CONNECTION_SHARDS='{"altrataPeopleA":["PersonProfile","CareerHistory","BoardMembership"],"altrataWealthB":["WealthIndicator","RelationshipPath"],"altrataOrgsC":["Organization"]}'


# -----------------------------------------------------------------------------
# ALTRATA BULK FEEDS (primary ingestion)
# -----------------------------------------------------------------------------
# FEED_PATH (REQUIRED for ingestion): local directory where Altrata deliveries
#   land via SFTP. Each delivery is a subdirectory with manifest.json
#   (per-file SHA-256 + record counts) and JSON/CSV data files. docs/FEEDS.md.
FEED_PATH=/srv/altrata/feeds

# RETENTION_DAYS (optional, default 0 = keep forever): archive/delete feed
#   files this many days after SUCCESSFUL processing. State is never touched.
# RETENTION_DAYS=30

# RETENTION_MODE (optional, default archive): archive (move to FEED_PATH/archive)
#   or delete.
# RETENTION_MODE=archive

# CRM_CONTACTS_PATH (optional): JSON or CSV export of internal CRM contacts
#   (id,email,name,employer[,role/title]) used for entity resolution
#   (deterministic email first, then normalized name+employer, then the
#   optional fuzzy tier below). The altrata_id↔crm_contact_id crosswalk is
#   stored in the identity store with match-rule + confidence provenance.
# CRM_CONTACTS_PATH=/srv/altrata/crm_contacts.json

# ENTITY_FUZZY_MATCHING (optional, default false): enable the scored fuzzy
#   tier beneath the deterministic rules (docs/MATCHING.md). Weights:
#   name-token overlap 0.6, employer 0.3, role hint 0.1.
# ENTITY_FUZZY_MATCHING=false

# ENTITY_MATCH_THRESHOLD (optional, default 0.85, range (0,1]): auto-link at
#   or above this score; the score is emitted as crmMatchConfidence.
# ENTITY_MATCH_THRESHOLD=0.85

# ENTITY_REVIEW_FLOOR (optional, default 0.6, must be < threshold): candidates
#   scoring in [floor, threshold) are appended to
#   logs/match_review_{CONNECTOR_ID}.jsonl for human review instead of linking.
# ENTITY_REVIEW_FLOOR=0.6


# -----------------------------------------------------------------------------
# RELATIONSHIP-PATH MATERIALIZATION (docs/RELATIONSHIP_PATHS.md)
# -----------------------------------------------------------------------------
# RELATIONSHIP_PATHS (optional, default false): precompute bounded per-person
#   path summaries from the RelationshipPath/BoardMembership/Organization
#   datasets and materialize them onto PersonProfile items as searchable/
#   refinable properties (firstDegreeCount, secondDegreeCount, pathCount,
#   topConnectedOrgs, strongestPathSummary). Rebuilt per crawl in the identity
#   store; delta-tombstone-aware (a withdrawn person drops from the index).
#   Path properties never widen ACLs — items stay seat-only.
# RELATIONSHIP_PATHS=false

# RELATIONSHIP_TOP_ORGS (optional, default 3, range 1-10): cap on the
#   materialized topConnectedOrgs list.
# RELATIONSHIP_TOP_ORGS=3


# -----------------------------------------------------------------------------
# ALTRATA REST API (secondary, on-demand enrichment — billable)
# -----------------------------------------------------------------------------
# All four must be set for `ingest-item` to work; feeds work without them.
# ALTRATA_API_BASE_URL=https://api.altrata.com/v1
# ALTRATA_TOKEN_URL=https://auth.altrata.com/oauth/token
# ALTRATA_CLIENT_ID=your-altrata-api-client-id
# --- SECRET: put in env/.env.local.user
# SECRET_ALTRATA_CLIENT_SECRET=your-altrata-api-client-secret

# ALTRATA_API_CALLS_PER_MINUTE (optional, default 60): client-side sliding-window
#   throttle. Every successful lookup increments the persisted billable counter
#   (altrata_api_billable_lookups_total on /metrics) and is audit-logged.
# ALTRATA_API_CALLS_PER_MINUTE=60


# -----------------------------------------------------------------------------
# SEAT-BASED ENTITLEMENT (docs/ENTITLEMENT.md — READ THIS)
# -----------------------------------------------------------------------------
# Items are visible ONLY to licensed seats. Exactly one seat source:
#
# SEAT_GROUP_ID (option A): a single Entra security group id; group membership
#   is the seat list (evaluated by Microsoft Search at query time).
# SEAT_GROUP_ID=00000000-0000-0000-0000-000000000000
#
# SEAT_LIST_PATH (option B, default config/seats.json): JSON file with the
#   seated UPNs and/or Entra object IDs:
#   {"users": ["a@contoso.com", "<object-id>"], "groups": ["<group-id>"]}
#   A changed seat list (hash) triggers a re-ACL pass over every ingested item.
#   An EMPTY seat list stops ingestion (fails closed, never falls open).
# SEAT_LIST_PATH=config/seats.json


# -----------------------------------------------------------------------------
# PER-SUBJECT ERASURE / DSAR (docs/ERASURE.md — no env knobs)
# -----------------------------------------------------------------------------
# `forget-subject --id X | --email e --confirm` erases one person and adds them
# to a durable suppression list so future crawls never re-ingest them (counted
# as suppressed in reconciliation, not dead-lettered). `unsuppress-subject`
# lifts the block. Erasures are recorded in a tamper-evident, hash-chained
# ledger at logs/erasure_ledger_{CONNECTOR_ID}.jsonl (retained across purge-all).
# No configuration required; the suppression list lives in the state backend.


# -----------------------------------------------------------------------------
# STATE BACKEND (optional; default = files + SQLite)
# -----------------------------------------------------------------------------
# USE_SQL_SERVER (default false): move ALL state (identity store, checkpoints,
#   sync timestamps, dead-letter, ledger, counters) to SQL Server. Required for
#   HA_MODE. docs/SQL_CONTRACT.md.
# USE_SQL_SERVER=false

# SQL_CONNECTION_STRING (required when USE_SQL_SERVER=true).
# SQL_CONNECTION_STRING=Server=sql1;Database=AltrataConnector;Integrated Security=true;TrustServerCertificate=true

# SQL_USE_MANAGED_IDENTITY (default false): Entra managed identity auth
#   (appends Authentication=Active Directory Default when not already set).
# SQL_USE_MANAGED_IDENTITY=false

# SQL_MAX_RETRIES (default 3): transient-fault retries per SQL command.
# SQL_MAX_RETRIES=3

# HA_MODE (default false): active-active multi-node crawling via the
#   dbo.altrata_leases lease table (requires USE_SQL_SERVER=true). docs/HA.md.
# HA_MODE=false

# HA_NODE_ID (optional, default machine:pid): stable node name for leases.
# HA_NODE_ID=node-01


# -----------------------------------------------------------------------------
# SECRETS BACKEND (optional)
# -----------------------------------------------------------------------------
# USE_KEY_VAULT (default false): resolve SECRET_* from Azure Key Vault when not
#   present in the environment. Vault secret name = lowercased env name with
#   '_' → '-' (SECRET_AAD_APP_CLIENT_SECRET → secret-aad-app-client-secret).
#   Uses DefaultAzureCredential (managed identity / az login / VS).
# USE_KEY_VAULT=false
# KEY_VAULT_URI=https://your-vault.vault.azure.net/


# -----------------------------------------------------------------------------
# OBSERVABILITY & ALERTING (optional; docs/OBSERVABILITY.md)
# -----------------------------------------------------------------------------
# HEALTH_PORT (default off): serve GET /health, /ready and /metrics
#   (Prometheus text) on this port.
# HEALTH_PORT=9090

# LOG_FORMAT (default text): json → one-line structured JSON records.
# LOG_FORMAT=json

# LOG_LEVEL (default info): debug → emit DEBUG lines. Off by default; the
#   ingest hot path gates expensive debug formatting (full $batch response
#   serialization) behind this flag, so leave it unset in production.
# LOG_LEVEL=debug

# LOG_RETENTION_DAYS (default off): prune logs/{prefix}_{timestamp}/ run
#   directories older than this many days at command start.
# LOG_RETENTION_DAYS=14

# ALERT_WEBHOOK_URL (default off): POST JSON alerts (delivery rejected on
#   checksum mismatch, reconciliation mismatch, entitlement violations,
#   dead-letter threshold) to this URL (Teams/Slack-compatible payload shape).
# ALERT_WEBHOOK_URL=https://example.webhook.office.com/...

# ALERT_DEADLETTER_THRESHOLD (default 0 = off): alert when the dead-letter
#   queue depth reaches this many records.
# ALERT_DEADLETTER_THRESHOLD=100


# -----------------------------------------------------------------------------
# DISTRIBUTED TRACING (OpenTelemetry; docs/OBSERVABILITY.md)
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT (default off): OTLP collector URL. When set, the
#   connector exports spans (crawl → delivery → dataset ingest → graph batch,
#   plus entity resolution, path-index build, enrichment lookup, forget-subject,
#   seat-sync/re-ACL). Unset = tracing not registered, zero overhead. An
#   unreachable collector never blocks/fails a crawl (batched, fire-and-forget).
#   PII CAUTION: spans carry ids/counts/hashes only — never names/emails/wealth.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Standard OTEL_* vars are honoured, e.g.:
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc            # or http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20...
# OTEL_SERVICE_NAME=AltrataWealth             # defaults to CONNECTOR_NAME
#
# A correlation id is stamped on every structured JSON log line, dead-letter
# record, reconciliation report and erasure-ledger entry regardless of OTLP
# export — so a crawl/erasure cycle is followable end-to-end by correlation id.


# -----------------------------------------------------------------------------
# CIRCUIT BREAKERS / DEGRADED MODE (docs/RESILIENCE.md)
# -----------------------------------------------------------------------------
# Fail-fast on SUSTAINED dependency outages (distinct from retry/backoff). Each
# external dependency has its own breaker: graph (critical — drives readiness &
# the degraded-mode crawl pause) and altrata-api (non-critical). 5xx/timeout/
# connection trip; 4xx/validation and honored 429s do NOT. Happy path is inert.
#
# CIRCUIT_BREAKER (default true): master switch; false = pure passthrough.
# CIRCUIT_BREAKER=true
#
# CIRCUIT_BREAKER_FAILURE_THRESHOLD (default 5): failures within the window that
#   open a breaker.
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
#
# CIRCUIT_BREAKER_WINDOW_SECONDS (default 60): rolling failure window.
# CIRCUIT_BREAKER_WINDOW_SECONDS=60
#
# CIRCUIT_BREAKER_OPEN_SECONDS (default 30): how long a breaker stays open
#   (fail-fast) before it half-opens and probes.
# CIRCUIT_BREAKER_OPEN_SECONDS=30
#
# CIRCUIT_BREAKER_HALFOPEN_TRIALS (default 2): probe successes needed to close.
# CIRCUIT_BREAKER_HALFOPEN_TRIALS=2
#
# When the graph breaker opens, the crawl pauses at a safe checkpoint/delivery
# boundary (no dead-letters) and auto-recovers on the next crawl once the
# breaker probes successfully. /ready → 503 while open; /health stays up.


# -----------------------------------------------------------------------------
# PATH OVERRIDES (rarely needed; used by tests and unusual layouts)
# -----------------------------------------------------------------------------
# DATA_DIR (default ./data): identity DB + state JSON location.
# LOGS_DIR (default ./logs): run logs, checkpoint, dead-letter, audit, reports.
# ALTRATA_CONNECTOR_HOME: working directory when running as a Windows service.
