<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AltrataConnector</RootNamespace>
    <!-- Release version; CI overrides with -p:Version on tag builds and the
         MSI (packaging/msi/Package.wxs) must match — guarded by a test. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AltrataConnector.Tests" />
  </ItemGroup>

  <!-- The chassis lives in this repository, so it is referenced as a project
       rather than a published package. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Connector.Chassis\Connector.Chassis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Connector.Chassis.Logging" Alias="Logging" />
    <Using Include="Connector.Chassis.IAppLogger" Alias="IAppLogger" />
    <Using Include="Connector.Chassis.EnvFlags" Alias="EnvFlags" />
    <Using Include="Connector.Chassis.ServiceStop" Alias="ServiceStop" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Pin above Microsoft.Data.Sqlite 10.0.9's transitive 2.1.11 (NU1903, GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <!-- Windows Event Log mirroring (EVENTLOG_ENABLED; no-op off Windows). -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
