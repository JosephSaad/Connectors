{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping the connector's HEALTH_PORT /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Altrata Copilot Connector",
  "uid": "altrata-connector",
  "tags": ["altrata", "copilot-connector", "m365"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest throughput (items/s)",
      "description": "PUTs landed per second across full + incremental crawls. Flat while altrata_crawl_in_progress=0 is normal.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(altrata_items_ingested_total[5m])", "legendFormat": "ingested/s" },
        { "refId": "B", "expr": "rate(altrata_items_deleted_total[5m])", "legendFormat": "withdrawn/s" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingested vs failed vs suppressed (1h increase)",
      "description": "Failures dead-letter and replay via retry-failed; suppressed = erased subjects skipped (DSAR durability working).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "increase(altrata_items_ingested_total[1h])", "legendFormat": "ingested (1h)" },
        { "refId": "B", "expr": "increase(altrata_items_failed_total[1h])", "legendFormat": "failed → dead-letter (1h)" },
        { "refId": "C", "expr": "increase(altrata_items_suppressed_total[1h])", "legendFormat": "suppressed (erased subjects) (1h)" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dead-letter depth",
      "description": "Replayable queue depth (drives the deadletter_threshold alert) + un-replayable transform failures (need a feed fix, not a replay). Runbook: docs/RUNBOOKS.md#dead-letter-growth",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "altrata_deadletter_depth", "legendFormat": "replayable" },
        { "refId": "B", "expr": "altrata_deadletter_unreplayable", "legendFormat": "un-replayable (transform)" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Graph 429 throttles & retries",
      "description": "Sustained 429 rate = tenant quota contention. Runbook: docs/RUNBOOKS.md#429-storm",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(altrata_graph_throttle_429_total[5m])", "legendFormat": "429/s" },
        { "refId": "B", "expr": "rate(altrata_graph_retries_total[5m])", "legendFormat": "retries/s" },
        { "refId": "C", "expr": "rate(altrata_graph_requests_total[5m])", "legendFormat": "requests/s" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Circuit breaker (critical dependency)",
      "description": "1 = Graph breaker OPEN, crawl paused at checkpoint (degraded). Runbook: docs/RUNBOOKS.md#breaker-open--degraded-mode",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "OPEN (degraded)", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "altrata_breaker_open", "legendFormat": "breaker open" } ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Erasure ledger integrity",
      "description": "1 = hash chain FAILED verification — SECURITY INCIDENT. Runbook: docs/RUNBOOKS.md#ledger-verify-failure",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "VERIFIED", "color": "green" }, "1": { "text": "BROKEN — security incident", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "altrata_erasure_ledger_broken", "legendFormat": "ledger broken" } ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Entitlement refusals (fail-closed events)",
      "description": "Empty seat list / forbidden everyone-grant refusals. Any nonzero needs a look. Runbook: docs/RUNBOOKS.md#seat-file-parse-failure",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "increase(altrata_entitlement_refusals_total[1h])", "legendFormat": "refusals (1h)" },
        { "refId": "B", "expr": "altrata_seat_count", "legendFormat": "seat principals" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Erasure operations (DSAR)",
      "description": "Subjects erased, items withdrawn by erasure, suppression-list size (erased subjects blocked from re-ingest).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "increase(altrata_subjects_erased_total[24h])", "legendFormat": "subjects erased (24h)" },
        { "refId": "B", "expr": "increase(altrata_items_erased_total[24h])", "legendFormat": "items withdrawn by erasure (24h)" },
        { "refId": "C", "expr": "altrata_suppression_list_size", "legendFormat": "suppression list size" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Review queue & HA leases",
      "description": "Match-review adjudication backlog (docs/RUNBOOKS.md#review-queue-growth) and per-node HA leases held (docs/RUNBOOKS.md#lease-stuck).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "altrata_match_review_depth", "legendFormat": "review-queue depth" },
        { "refId": "B", "expr": "altrata_ha_leases_held", "legendFormat": "HA leases held (this node)" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Deliveries processed vs rejected",
      "description": "Rejected = checksum/manifest gate fired; nothing from that delivery ingested. Runbook: docs/RUNBOOKS.md#feed-manifest-mismatch",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "increase(altrata_deliveries_processed_total[24h])", "legendFormat": "processed (24h)" },
        { "refId": "B", "expr": "increase(altrata_deliveries_rejected_total[24h])", "legendFormat": "REJECTED (24h)" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Crawl freshness",
      "description": "Seconds since the last completed full / incremental crawl closed.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 129600 }, { "color": "red", "value": 172800 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "time() - altrata_last_full_crawl_timestamp_seconds", "legendFormat": "since last full" },
        { "refId": "B", "expr": "time() - altrata_last_incremental_crawl_timestamp_seconds", "legendFormat": "since last incremental" }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Ops counters",
      "description": "Crawl running now, re-ACL passes, billable enrichment lookups (lifetime, persisted).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "altrata_crawl_in_progress", "legendFormat": "crawl in progress" },
        { "refId": "B", "expr": "altrata_reacl_passes_total", "legendFormat": "re-ACL passes" },
        { "refId": "C", "expr": "altrata_api_billable_lookups_total", "legendFormat": "billable lookups (lifetime)" }
      ]
    }
  ]
}
