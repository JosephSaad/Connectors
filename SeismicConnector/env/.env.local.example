# =============================================================================
# Seismic Copilot Connector — environment template
# =============================================================================
# HOW TO USE THIS FILE
#   1. Copy it to env/.env.local           (non-secret config, may be per-node)
#   2. Put every SECRET_* value in         env/.env.local.user
#   3. NEVER commit .env.local or .env.local.user — only this .example is tracked.
#
# Both files are loaded automatically from env/.env.local and env/.env.local.user
# (fallback: ./.env.local and ./.env.local.user in the repo root). Values already
# present in the real process environment always win, so container/Windows-service
# env blocks can override anything here.
#
# CONVENTIONS
#   * "REQUIRED" variables must be set or startup fails with
#     "Invalid configuration: Missing <NAME>".
#   * Optional variables show their built-in default; leave them unset to keep it.
#     Every operational knob in the last sections is OFF BY DEFAULT.
#   * Booleans are truthy for: true / 1 / yes (case-insensitive).
# =============================================================================


# -----------------------------------------------------------------------------
# CORE / IDENTITY  (all REQUIRED)
# -----------------------------------------------------------------------------
# CONNECTOR_ID: unique id of the Graph external connection. 3-32 chars,
#   alphanumeric only, must not start with a reserved Microsoft prefix
#   (Microsoft, SharePoint, Teams, ...). Also keys all on-disk state:
#   data/{CONNECTOR_ID}_identity.db, logs/checkpoint_{CONNECTOR_ID}.json,
#   logs/failed_records_{CONNECTOR_ID}.jsonl.
CONNECTOR_ID=SeismicSales

# CONNECTOR_NAME: display name in the Microsoft 365 admin center.
CONNECTOR_NAME=Seismic Sales Content

# CONNECTOR_DESCRIPTION: short description shown in Microsoft Search / Copilot.
CONNECTOR_DESCRIPTION=Seismic sales enablement content synced to Microsoft 365 Copilot.


# -----------------------------------------------------------------------------
# SEISMIC
# -----------------------------------------------------------------------------
# SEISMIC_TENANT (REQUIRED): your Seismic tenant subdomain, e.g. "contoso" for
#   contoso.seismic.com.
SEISMIC_TENANT=your-tenant

# SEISMIC_CLIENT_ID (REQUIRED): OAuth2 client id of the Seismic API client
#   (client-credentials flow; Seismic Admin -> Integrations -> API clients).
SEISMIC_CLIENT_ID=your-seismic-client-id

# --- SECRET: put this line in env/.env.local.user, NEVER here
# SECRET_SEISMIC_CLIENT_SECRET (REQUIRED): Seismic API client secret.
# SECRET_SEISMIC_CLIENT_SECRET=your-seismic-client-secret

# SEISMIC_API_BASE_URL (optional, default https://api.seismic.com)
# SEISMIC_API_BASE_URL=https://api.seismic.com

# SEISMIC_AUTH_URL (optional, default
#   https://auth.seismic.com/tenants/{SEISMIC_TENANT}/connect/token)
# SEISMIC_AUTH_URL=

# SEISMIC_PAGE_SIZE (optional, default 100, max 500): list-endpoint page size.
# SEISMIC_PAGE_SIZE=100

# SEISMIC_QUERY_LIMIT (optional, default 0 = unlimited): dev/debug cap on items
#   fetched per teamsite.
# SEISMIC_QUERY_LIMIT=0

# SEISMIC_MAX_RETRIES (optional, default 4): retries on Seismic 429/5xx.
#   Server Retry-After honoured exactly; else exponential backoff capped at 60s.
# SEISMIC_MAX_RETRIES=4

# SEISMIC_MAX_EXTRACT_MB (optional, default 10): max payload size downloaded for
#   text extraction; larger items are indexed metadata-only.
# SEISMIC_MAX_EXTRACT_MB=10

# SEISMIC_WEBHOOK_PORT (optional, default 0 = disabled): >0 starts the HTTP
#   listener for Seismic content webhooks (POST /webhook) for near-real-time
#   updates. Polling on the modifiedAt cursor remains the fallback.
# SEISMIC_WEBHOOK_PORT=8090
#
# SEISMIC_WEBHOOK_SECRET (REQUIRED when SEISMIC_WEBHOOK_PORT>0): shared secret
#   for HMAC-SHA256 request authentication. The sender signs the raw body and
#   sends it in the X-Seismic-Signature header (hex or base64, optional
#   "sha256=" prefix); the receiver validates over the exact raw bytes BEFORE
#   parsing or enqueuing anything, with a constant-time compare. If the port is
#   set but this is missing, the receiver REFUSES TO START (fail-closed) and the
#   connector falls back to polling only. Can be resolved from Key Vault.
# SEISMIC_WEBHOOK_SECRET=change-me
#
# --- Webhook anti-replay (defends against captured-request replay) ---
# The sender sends a signed timestamp header and computes the HMAC over
#   `timestamp + "." + rawBody` (the timestamp is BOUND INTO the signature). The
#   receiver rejects a request whose timestamp is outside the freshness window,
#   and rejects a duplicate signature seen again within the window.
#
# SEISMIC_WEBHOOK_REQUIRE_TIMESTAMP (optional, DEFAULT TRUE): require a valid
#   fresh signed timestamp. Set false ONLY to migrate senders that cannot yet
#   send one — those fall back to legacy body-only HMAC with NO replay
#   protection. Anti-replay is real whenever a timestamp IS present.
# SEISMIC_WEBHOOK_REQUIRE_TIMESTAMP=true
#
# SEISMIC_WEBHOOK_REPLAY_WINDOW_SECONDS (optional, default 300 = 5 min): freshness
#   window; also how long a seen signature is remembered for replay dedup.
# SEISMIC_WEBHOOK_REPLAY_WINDOW_SECONDS=300
#
# SEISMIC_WEBHOOK_TIMESTAMP_HEADER (optional, default X-Seismic-Timestamp): the
#   request header carrying the signed timestamp (Unix seconds or ISO-8601).
# SEISMIC_WEBHOOK_TIMESTAMP_HEADER=X-Seismic-Timestamp

# SEISMIC_FALLBACK_ACL (optional, default skip): what to do when NO Seismic
#   principal on an item maps to Entra ID —
#     skip   = do not ingest the item (compliance-safe default)
#     tenant = grant everyone in the tenant
#   Items with no item-level permissions inherit the teamsite's permissions
#   first; the fallback applies only when nothing maps after that. 'tenant'
#   only ever applies to content genuinely WITHOUT principals: if the source
#   has principals but none currently maps (stale identity store), an already
#   indexed item's ACL is left unchanged — never widened to everyone.
# SEISMIC_FALLBACK_ACL=skip

# SEISMIC_ENRICH_USAGE (optional, default false): true → fetch per-content
#   usage analytics (views/downloads/shares) once per crawl and index them as
#   refinable properties (viewCount, downloadCount, shareCount,
#   popularityScore) so Copilot can rank popular collateral higher.
#   Best-effort: an analytics failure never fails the crawl.
# SEISMIC_ENRICH_USAGE=false

# LIVEDOC_FIELD_INDEXING (optional, default false): true → for LiveDoc
#   (generated-document template) content, fetch its field/variable metadata
#   (the personalization inputs it exposes) and index the input names/labels
#   as refinable properties (isLiveDoc, liveDocFieldNames, liveDocFieldCount)
#   and into the searchable content text — so a LiveDoc parameterized by
#   "client name / product / region" is findable by those inputs. The extra
#   API call is made ONLY for LiveDoc items and ONLY when this is set;
#   non-LiveDoc items and disabled config incur zero new calls. Best-effort:
#   a field-fetch failure indexes the item without the metadata.
# LIVEDOC_FIELD_INDEXING=false

# PERMISSION_REACL (optional, default false): true → on each crawl, re-resolve
#   permissions for content whose payload did NOT change and re-ACL (ACL-only
#   Graph PATCH, no content re-send) any item whose resolved principal set
#   drifted — so a teamsite/content-profile permission change is reflected in
#   the index even when the content itself is untouched. Compliance-safe: if an
#   item's permissions can't be resolved, its ACL is LEFT UNCHANGED (never
#   widened). The `reacl [--dry-run]` command performs the same audit/repair on
#   demand regardless of this flag. For entitlement freshness, schedule `reacl`
#   on a cadence (e.g. hourly) so ACL drift on unchanged content is bounded.
# PERMISSION_REACL=false

# GRAPH_ITEM_TTL_DAYS (optional, default 0 = unset): >0 → every ingested item is
#   stamped with expirationDateTime = now + TTL so the index SELF-EXPIRES if
#   crawling stops (defense-in-depth after an outage — a stale, no-longer-
#   refreshed item ages out instead of lingering). Each fresh crawl re-stamps a
#   new now+TTL, so live content never expires. Choose a TTL comfortably longer
#   than your full-crawl interval (e.g. 7–30 days for a daily crawl).
# GRAPH_ITEM_TTL_DAYS=0


# -----------------------------------------------------------------------------
# AZURE AD / MICROSOFT GRAPH
# -----------------------------------------------------------------------------
# The app registration needs these APPLICATION permissions (admin-consented):
#   ExternalConnection.ReadWrite.OwnedBy, ExternalItem.ReadWrite.OwnedBy,
#   User.Read.All, Group.Read.All (identity mapping).
#
# AAD_APP_TENANT_ID (REQUIRED): Entra tenant id.
AAD_APP_TENANT_ID=00000000-0000-0000-0000-000000000000

# AAD_APP_CLIENT_ID (REQUIRED): Entra application (client) id.
AAD_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- SECRET: put this line in env/.env.local.user, NEVER here
# SECRET_AAD_APP_CLIENT_SECRET (REQUIRED): Entra app client secret VALUE.
#   With USE_KEY_VAULT=true this may instead live in Key Vault (below).
# SECRET_AAD_APP_CLIENT_SECRET=your-entra-app-client-secret

# GRAPH_API_VERSION (optional, default v1.0): v1.0 or beta.
# GRAPH_API_VERSION=v1.0

# GRAPH_MAX_RETRIES (optional, default 4): retries on Graph 429/5xx. docs/RETRY.md.
# GRAPH_MAX_RETRIES=4

# GRAPH_RETRY_BACKOFF_BASE (optional, default 2): exponential backoff base in
#   seconds (base * 2^attempt, capped 60s; server Retry-After honoured exactly).
# GRAPH_RETRY_BACKOFF_BASE=2

# --- Sovereign / national clouds (all read LIVE per access, so container env
#     blocks can flip them without a config reload) ---
# GRAPH_BASE_URL (optional, default https://graph.microsoft.com): Graph
#   endpoint, e.g. https://graph.microsoft.us (US Government) or
#   https://microsoftgraph.chinacloudapi.cn (21Vianet).
# GRAPH_SCOPE (optional, default <GRAPH_BASE_URL>/.default): token audience —
#   set only if your cloud's audience differs from the base URL.
# AAD_APP_OAUTH_AUTHORITY_HOST (optional, default
#   https://login.microsoftonline.com): OAuth authority host for token
#   acquisition, e.g. https://login.microsoftonline.us.
# GRAPH_BASE_URL=https://graph.microsoft.com


# -----------------------------------------------------------------------------
# CONNECTION & SCHEMA PROVISIONING
# -----------------------------------------------------------------------------
# CONNECTION_TIMEOUT_SECONDS (optional, default 600)
# CONNECTION_RETRY_INTERVAL_SECONDS (optional, default 15)
# SCHEMA_RETRY_INTERVAL_SECONDS (optional, default 15)


# -----------------------------------------------------------------------------
# BATCHING & PARALLELISM
# -----------------------------------------------------------------------------
# INGEST_CHUNK_SIZE (optional, default 200): content items per checkpoint chunk.
# INGEST_CHUNK_SIZE=200

# INGEST_GRAPH_BATCH_SIZE (optional, default 20): requests per Graph $batch POST.
#   Hard-capped at 20 by the API. GRAPH_BATCH_SIZE is an accepted alias
#   (explicit INGEST_GRAPH_BATCH_SIZE wins when both are set).
# INGEST_GRAPH_BATCH_SIZE=20
# GRAPH_BATCH_SIZE=20

# GRAPH_BATCH_WORKERS (optional, default 4): MAX concurrent Graph $batch
#   workers. Adaptive concurrency dials the live count 1..max on 429 feedback
#   (docs/RETRY.md). In HA_MODE set this to (single-node value / node count) —
#   the Graph 429 quota is shared per connection. docs/HA.md.
#   NOTE: GRAPH_CONCURRENT_BATCHES is an alias and WINS if both are set.
# GRAPH_BATCH_WORKERS=4
# GRAPH_CONCURRENT_BATCHES=4


# =============================================================================
# OPERATIONAL KNOBS — all OFF BY DEFAULT (unset == classic file/SQLite behaviour)
# =============================================================================

# -----------------------------------------------------------------------------
# CONNECTION SHARDING  — docs/SHARDING.md
# -----------------------------------------------------------------------------
# GRAPH_CONNECTION_SHARDS (optional, default unset): JSON object mapping each
#   Graph connection id to the schema object types it owns. When set, each
#   shard is its own Graph connection + schema and ingests only its object
#   types (the ingestion rate limit is per connection, so k shards ≈ k × the
#   single-connection throughput). Every enabled schema.json object must be
#   assigned to exactly one shard (no dups, no unknowns); validate-config
#   checks this.
# GRAPH_CONNECTION_SHARDS={"seismicContent":["ContentItem"],"seismicLibs":["Library"]}


# -----------------------------------------------------------------------------
# SQL SERVER STATE BACKEND  — docs/SQL_CONTRACT.md
# -----------------------------------------------------------------------------
# Moves identity store, tracked items, checkpoints, sync timestamps and the
# dead-letter queue from files/SQLite into a shared SQL Server DB. Required for
# HA. Provision the DB once with scripts/sql/create-database.sql (+
# create-login.sql for a least-privilege app login); the connector also
# auto-provisions the tables on first use.
#
# USE_SQL_SERVER (optional, default false)
# USE_SQL_SERVER=false

# SQL_CONNECTION_STRING: REQUIRED when USE_SQL_SERVER=true. For HA point it at
#   the Always On AG LISTENER. Encrypt=True is forced unless the string sets it.
# SQL_CONNECTION_STRING=Server=tcp:seismic-ag,1433;Database=SeismicConnector;User ID=seismic_app;Password=<in .env.local.user>;Encrypt=True

# SQL_USE_MANAGED_IDENTITY (optional, default false): Entra Managed Identity
#   token auth instead of connection-string credentials.
# SQL_USE_MANAGED_IDENTITY=false

# SQL_MAX_RETRIES (optional, default 5): transient-fault retry count.
# SQL_MAX_RETRIES=5


# -----------------------------------------------------------------------------
# HIGH AVAILABILITY (active-active)  — docs/HA.md
# -----------------------------------------------------------------------------
# Requires USE_SQL_SERVER=true (startup fails fast otherwise). Every node runs
# the SAME --continuous command against the SAME database; teamsites are
# claimed through the SQL lease table (CrawlClaims).
#
# HA_MODE (optional, default false)
# HA_MODE=false

# NODE_ID (optional, default = machine name): stable, unique per node.
# NODE_ID=seismic-node-1

# HA_CLAIM_TIMEOUT_SECONDS (optional, default 300): claims with a heartbeat
#   older than this are stolen. Keep comfortably > HA_HEARTBEAT_SECONDS.
# HA_CLAIM_TIMEOUT_SECONDS=300

# HA_HEARTBEAT_SECONDS (optional, default 60)
# HA_HEARTBEAT_SECONDS=60


# -----------------------------------------------------------------------------
# RETRY / THROTTLING  — docs/RETRY.md
# -----------------------------------------------------------------------------
# GRAPH_RETRY_JITTER (optional, default false): true → +-20% jitter on COMPUTED
#   Graph backoff (server Retry-After is never jittered). Strongly recommended
#   on every HA node.
# GRAPH_RETRY_JITTER=false


# -----------------------------------------------------------------------------
# LOG RETENTION
# -----------------------------------------------------------------------------
# LOG_RETENTION_DAYS (optional, default 0 = keep forever): >0 prunes
#   logs/{prefix}_{timestamp}/ run directories older than N days at the start
#   of every command and each --continuous cycle. Root state files are never touched.
#   A value larger than any log can be old (e.g. 1000000) is clamped to "keep
#   everything" rather than failing the command.
# LOG_RETENTION_DAYS=0


# -----------------------------------------------------------------------------
# AZURE KEY VAULT (secret resolution)
# -----------------------------------------------------------------------------
# When enabled, SECRET_* values are read from Key Vault. Secret name = env-var
# name lowercased with '_' -> '-' (SECRET_SEISMIC_CLIENT_SECRET ->
# secret-seismic-client-secret). Auth: DefaultAzureCredential. Falls back to
# the env var when a fetch fails.
#
# USE_KEY_VAULT (optional, default false)
# USE_KEY_VAULT=false
# KEY_VAULT_URI: REQUIRED when USE_KEY_VAULT=true.
# KEY_VAULT_URI=https://your-vault.vault.azure.net/


# -----------------------------------------------------------------------------
# OBSERVABILITY  — docs/OBSERVABILITY.md
# -----------------------------------------------------------------------------
# HEALTH_PORT (optional, default 0 = disabled): >0 → serve /health, /ready and
#   /metrics (Prometheus text) on that port.
# HEALTH_PORT=8080

# LOG_FORMAT (optional, default text): json → one JSON object per log line
#   (timestamp/level/logger/message/correlation_id when a crawl is active).
# LOG_FORMAT=text

# ALERT_WEBHOOK_URL (optional): POST a JSON alert on crawl failure and when the
#   dead-letter depth crosses ALERT_DEADLETTER_THRESHOLD.
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/xxxx

# ALERT_DEADLETTER_THRESHOLD (optional, default 0 = off).
# ALERT_DEADLETTER_THRESHOLD=0


# -----------------------------------------------------------------------------
# INCREMENTAL IDENTITY SYNC  (entitlement freshness)
# -----------------------------------------------------------------------------
# IDENTITY_SYNC_ON_INCREMENTAL (optional, DEFAULT TRUE): run the identity crawl
#   on incremental content crawls too, not just full crawls. Re-syncing every
#   incremental shrinks the ACL-staleness lag from the full-crawl cadence
#   (hours–day) down to the incremental cadence (default 4h). Residual lag is
#   still NON-REAL-TIME: a permission change is only reflected at the next
#   incremental crawl, and re-ACL of already-indexed items whose content is
#   unchanged needs PERMISSION_REACL (per-crawl) or the `reacl` sweep run on a
#   cadence (e.g. a scheduled job). Set to false to restore full-crawl-only sync.
# IDENTITY_SYNC_ON_INCREMENTAL=true


# -----------------------------------------------------------------------------
# DISTRIBUTED TRACING  (OpenTelemetry / OTLP)  — docs/OBSERVABILITY.md
# -----------------------------------------------------------------------------
# A correlation id is minted per crawl cycle and stamped on every JSON log line,
# dead-letter record and reconciliation/reacl report entry REGARDLESS of these
# settings (the audit backbone is always on and near-zero cost). OTLP span
# EXPORT is opt-in and gated purely on OTEL_EXPORTER_OTLP_ENDPOINT: with it
# unset, no TracerProvider is registered and overhead is unchanged. A
# broken/unreachable collector never fails or stalls a crawl (batched, bounded
# queue, fire-and-forget on a background thread). Standard OTEL_* env vars are
# honoured by the exporter.
#
# OTEL_EXPORTER_OTLP_ENDPOINT (optional, default unset = tracing inert): OTLP
#   collector endpoint, e.g. http://otel-collector:4318 (HTTP/protobuf) or
#   http://otel-collector:4317 (gRPC).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# OTEL_EXPORTER_OTLP_PROTOCOL (optional, default http/protobuf): http/protobuf
#   or grpc. Also honoured: OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_TIMEOUT.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTEL_SERVICE_NAME (optional, default = CONNECTOR_NAME): the service.name
#   resource attribute on exported spans.
# OTEL_SERVICE_NAME=seismic-connector


# -----------------------------------------------------------------------------
# CIRCUIT BREAKERS  (degraded mode / fail-safe)  — docs/RESILIENCE.md
# -----------------------------------------------------------------------------
# Distinct from retry/backoff (which absorbs transient blips within a call): a
# breaker handles a SUSTAINED outage by failing fast ACROSS calls, so the
# connector stops hammering a dead dependency and pauses into degraded mode at
# a safe checkpoint boundary (finish/flush in-flight batch, save checkpoint),
# resuming automatically when the dependency recovers. Each external dependency
# (Seismic API, Microsoft Graph) has its own breaker. Real failures
# (5xx/timeout/connection) trip it; 4xx and honored 429 (flow control) do NOT.
# Enabled by default and inert on the happy path.
#
# CIRCUIT_BREAKER (optional, default true): false = pure passthrough escape
#   hatch (no fail-fast / degraded-mode protection).
# CIRCUIT_BREAKER=true

# CIRCUIT_BREAKER_FAILURE_THRESHOLD (optional, default 5): tripping failures
#   within the window that open a breaker.
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# CIRCUIT_BREAKER_WINDOW_SECONDS (optional, default 60): failure-count window.
# CIRCUIT_BREAKER_WINDOW_SECONDS=60

# CIRCUIT_BREAKER_OPEN_SECONDS (optional, default 30): how long a breaker stays
#   open (failing fast) before allowing half-open probe calls.
# CIRCUIT_BREAKER_OPEN_SECONDS=30

# CIRCUIT_BREAKER_HALF_OPEN_TRIALS (optional, default 1): concurrent probe
#   calls allowed in the half-open state.
# CIRCUIT_BREAKER_HALF_OPEN_TRIALS=1


# -----------------------------------------------------------------------------
# ENTERPRISE HARDENING  — docs/DEPLOYMENT_ENTERPRISE.md, docs/SIEM.md, SECURITY.md
# -----------------------------------------------------------------------------
# EVENTLOG_ENABLED (optional, default false): true + Windows → mirror WARNING+
#   log records and lifecycle start/stop marks to the Windows Application Event
#   Log, source "SeismicConnector" (stable event ids 1000/1100/2000/3000 —
#   docs/SIEM.md). The source is created idempotently by
#   scripts/install-windows-service.ps1 (needs admin once); the service account
#   only needs write. Non-Windows: silently inert. The sink never throws.
# EVENTLOG_ENABLED=false

# EVENTLOG_LEVEL (optional, default warning): info → also mirror INFO records
#   (event id 1100). Any other value mirrors WARNING+ only.
# EVENTLOG_LEVEL=warning

# PROXY_URL (optional, default unset = direct): forward proxy for ALL outbound
#   HTTP (Seismic token+API, Graph token+API, alert webhook POSTs). Absolute
#   http(s) URL; anything else fails startup naming this setting.
# PROXY_URL=http://proxy.contoso.com:8080

# PROXY_BYPASS (optional): semicolon/comma-separated host wildcards that skip
#   the proxy, e.g. "*.contoso.local;10.*". Local addresses bypass by default.
# PROXY_BYPASS=

# CA_BUNDLE_PATH (optional, default unset = system trust only): PEM bundle of
#   ADDITIONAL trusted root/issuing CAs (TLS-inspection appliance, private
#   PKI). Additive: system-trusted chains keep working; hostname mismatches
#   are NEVER excused. Missing file / invalid PEM / empty bundle fail startup
#   naming this setting. Protect the file like a credential (THREAT_MODEL).
# CA_BUNDLE_PATH=/etc/pki/contoso-inspection-roots.pem

# GRAPH_CLIENT_CERT_PATH (optional): PFX (PKCS#12) or PEM file WITH private
#   key for Graph certificate-credential auth (RS256 client_assertion,
#   x5t#S256-bound, 10-minute lifetime). When set (or the thumbprint below),
#   the certificate WINS over SECRET_AAD_APP_CLIENT_SECRET and the secret
#   becomes optional. Only the auth MODE is ever logged.
# GRAPH_CLIENT_CERT_PATH=

# GRAPH_CLIENT_CERT_PASSWORD (optional): password for a protected PFX /
#   encrypted PEM. Secret-channel material — .env.local.user or Key Vault.
# GRAPH_CLIENT_CERT_PASSWORD=

# GRAPH_CLIENT_CERT_THUMBPRINT (optional): alternative to the path — hex
#   thumbprint looked up in the CurrentUser then LocalMachine "My" store
#   (Windows service deployments). Path wins when both are set.
# GRAPH_CLIENT_CERT_THUMBPRINT=

# DEADLETTER_PAYLOAD_MODE (optional, default REDACTED): controls what a
#   dead-letter record (file AND SQL backend) stores for request/response bodies.
#     redacted (DEFAULT) = indexed content and property VALUES are stripped —
#                ids, teamsite/version, error/attempt metadata, ACL entries and
#                SHA-256 stubs remain. No raw content/PII is ever written to disk.
#     full     = request/response bodies stored VERBATIM (opt-in; for debugging
#                on a trusted host — the record can contain indexed content/PII).
#   retry-failed is unaffected either way: it re-fetches everything from Seismic.
#   An UNRECOGNIZED value (typo) fails fast at startup instead of defaulting.
# DEADLETTER_PAYLOAD_MODE=redacted

# DECISION_LEDGER (optional, default false): true → write an append-only,
#   SHA-256 HASH-CHAINED audit ledger of compliance DECISIONS (No-MNE exclusions,
#   classification ACL restrictions and content-gate quarantines) to
#   logs/decision_ledger_{CONNECTOR_ID}.jsonl. Tamper-evident: any
#   edit/reorder/deletion breaks the chain (verifiable offline). Low-volume —
#   only exclusion/restriction/quarantine decisions are recorded, never every ingest.
#   The flag applies to EVERY command that runs the pipeline (full-deployment,
#   ingest, ingest-object, ingest-item, retry-failed, reconcile, reacl).
#
#   PATH CHANGED (see CHANGELOG): the ledger used to be written per run, inside
#   logs/{run}/decision_ledger_{CONNECTOR_ID}_{ts}.jsonl. It is now ONE file at
#   the logs ROOT that every run APPENDS to, so that
#     (a) LOG_RETENTION_DAYS (which deletes whole run directories) can never
#         delete it — the pruner also refuses to delete any run directory that
#         still holds an old per-run ledger, and names it in a warning;
#     (b) the hash chain is CONTINUOUS across runs (seq keeps climbing, each
#         run links to the previous one) instead of restarting from genesis
#         every run — a chain that resets cannot prove a whole run's ledger was
#         not deleted;
#     (c) it matches the rest of the connector fleet.
#   Existing per-run ledgers are left untouched and are NOT continued (each is
#   its own chain); the connector logs where they are on startup so they can be
#   archived alongside the new one. Assumes a single active connector process
#   per CONNECTOR_ID, as the other files in logs/ already do.
#   Ship the file off-box (SIEM / WORM storage) for a full tamper-PROOF guarantee.
# DECISION_LEDGER=false


# -----------------------------------------------------------------------------
# DATA CLASSIFICATION  (advisory tagging; NOT Microsoft Purview enforcement)
# -----------------------------------------------------------------------------
# CLASSIFICATION (optional, default false): true → run the dependency-free
#   content classifier over each ingested item's indexed text and stamp an
#   ADVISORY sensitivity classification TAG (the sensitivityLabel property:
#   Public < Internal < Confidential < Restricted) + detected categories.
#   IMPORTANT: this is a connector-applied tag for search/ranking/triage — it is
#   NOT a Purview sensitivity label and carries NO Purview enforcement
#   (no encryption, no DLP). Purview-aligned in NAMING only; no Purview API call.
#   Never weakens the No-MNE exclusion.
# CLASSIFICATION=false

# CLASSIFICATION_MANIFEST (optional, default false; requires CLASSIFICATION=true):
#   also write a per-crawl JSONL manifest (item → tag + categories + counts) for
#   a downstream catalog/DLP job.
# CLASSIFICATION_MANIFEST=false

# CLASSIFICATION_ENFORCE_ACL (optional, default false): OPTIONAL enforcement of
#   the advisory tag. When true, items whose derived tag is the top tier
#   (Restricted) have their Graph ACL RESTRICTED to CLASSIFICATION_ENFORCE_GROUP
#   (advisory tag → real access control, applied by THIS connector at the Graph
#   ACL, still independent of Purview). Requires CLASSIFICATION_ENFORCE_GROUP
#   (startup fails without it). Requires CLASSIFICATION=true to have any effect.
# CLASSIFICATION_ENFORCE_ACL=false

# CLASSIFICATION_ENFORCE_GROUP (required when CLASSIFICATION_ENFORCE_ACL=true):
#   Entra group OBJECT ID that Restricted items are locked to.
# CLASSIFICATION_ENFORCE_GROUP=00000000-0000-0000-0000-000000000000


# -----------------------------------------------------------------------------
# CONTENT GATE  (CS-1: malware + prompt-injection scanning)  — docs/CONTENT_GATE.md
# -----------------------------------------------------------------------------
# WHY: everything this connector ingests becomes Copilot GROUNDING CONTEXT. A
#   malicious document is therefore not just a bad file — it is an attack on
#   every user whose query it grounds. The ContentGate stage runs TWO
#   independent scanners over each item before it reaches the index:
#     BINARY channel -> an anti-malware gateway over the downloaded payload
#     TEXT channel   -> a prompt-injection heuristic over the FINAL indexed text
#
# POSTURE: QUARANTINE, NOT DROP. A blocked item still indexes its METADATA
#   (title/owner/URL stay findable); only the dangerous payload/text is
#   withheld. The item is written to the EXISTING dead-letter queue with reason
#   "content-gate:<category>", gets a "quarantine" decision-ledger entry, bumps
#   content_gate_blocked_total, raises the ALERT_WEBHOOK_URL alert and is stamped
#   with the contentGateStatus property. `retry-failed` re-drives it unchanged.
#
# CONTENT_GATE (optional, DEFAULT FALSE): master switch. With it unset the stage
#   is not constructed at all — no scanning, no new item properties, no rules
#   file read, no measurable cost. Behaviour is byte-identical to a connector
#   built before the gate existed.
# CONTENT_GATE=false

# CONTENT_GATE_ICAP_URL (optional, default unset): absolute http(s) URL of the
#   anti-malware gateway (ICAP-over-HTTP: c-icap, Symantec Protection Engine,
#   a ClamAV REST front-end, or the bank's own scanning service). The payload is
#   POSTed as application/octet-stream with the file name in X-Scan-Filename.
#   Responses: 204 or 2xx = clean; 2xx with an X-Infection-Found header or a
#   {"infected":true} body = infected; 403 = infected; anything else = the
#   scanner is UNAVAILABLE (see the fail modes below).
#   UNSET means the BINARY channel is not wired at all: payloads are not scanned
#   for malware and the connector logs a loud warning at startup. The TEXT
#   channel still runs. Outbound traffic honours PROXY_URL / CA_BUNDLE_PATH.
# CONTENT_GATE_ICAP_URL=http://icap-gateway.contoso.local/scan

# --- FAIL MODES: what happens when a scanner CANNOT BE REACHED ---------------
# The two channels default DIFFERENTLY, on purpose:
#
#   BINARY -> closed. Malware scanning is a real security control over genuinely
#             dangerous bytes. Indexing content that was never scanned defeats
#             the control entirely, so if the gateway is down the content is not
#             indexed (the item still lands metadata-only, dead-lettered).
#
#   TEXT   -> open. Injection detection is a HEURISTIC — regexes over prose, not
#             a security boundary. Halting a bank-wide crawl because a heuristic
#             could not run trades a certain, total availability loss for a
#             partial, probabilistic risk reduction. So the crawl PROCEEDS, but
#             loudly: a WARNING per item, the
#             content_gate_scanner_unavailable_total{channel="text"} counter, and
#             the item is stamped warn:scan-unavailable so the gap is visible in
#             the index itself, not only in a log nobody reads.
#
# NOTE the distinction: a REGEX MATCH TIMEOUT is not a scanner outage — it is one
#   pathological document — so it always FAILS SAFE and quarantines that single
#   item regardless of the text fail mode. A payload over
#   CONTENT_GATE_MAX_SCAN_MB counts as UNSCANNED and takes the binary fail mode.
#
# CONTENT_GATE_FAIL_MODE (optional): closed | open. Sets BOTH channels at once,
#   overriding the asymmetric defaults above. Per-channel knobs win over it.
# CONTENT_GATE_FAIL_MODE=

# CONTENT_GATE_FAIL_MODE_BINARY (optional, DEFAULT closed): closed | open.
# CONTENT_GATE_FAIL_MODE_BINARY=closed

# CONTENT_GATE_FAIL_MODE_TEXT (optional, DEFAULT open): closed | open.
# CONTENT_GATE_FAIL_MODE_TEXT=open
#
# An unrecognized fail mode (e.g. "shut") fails startup naming the setting —
# but only when CONTENT_GATE=true, so an unset gate can never add a new failure.

# CONTENT_GATE_MAX_SCAN_MB (optional, default 25): payloads larger than this are
#   not sent to the gateway. They count as UNSCANNED, so the binary fail mode
#   applies (closed by default = quarantined metadata-only). Raise it, or set
#   CONTENT_GATE_FAIL_MODE_BINARY=open, if your library carries large media.
# CONTENT_GATE_MAX_SCAN_MB=25

# CONTENT_GATE_SCAN_TIMEOUT_SECONDS (optional, default 30): per-payload gateway
#   deadline. A timeout is reported as UNAVAILABLE, not as clean.
# CONTENT_GATE_SCAN_TIMEOUT_SECONDS=30
#
# The injection ruleset lives in config/content-gate.json (read only when the
# gate is on) and is AUTHORITATIVE when present — the built-in patterns are not
# merged in, so you can narrow the set to kill a false positive without a
# rebuild. Categories must keep the "Injection." prefix: that prefix is what
# routes a hit to QUARANTINE instead of to a classification label.
# The gate is INDEPENDENT of CLASSIFICATION — it works with CLASSIFICATION=false.
